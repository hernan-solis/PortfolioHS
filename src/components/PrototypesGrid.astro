---
import { PROTOTYPES } from '../data/projects';
---

<section id="prototipos" class="pb-24 md:pb-36">
  <div class="wrap">
    <div class="grid md:grid-cols-12 gap-6 md:gap-10 items-end mb-12 md:mb-16 pt-16 md:pt-20 border-t border-line">
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">En camino</p>
        <h2 class="mt-5 text-2xl sm:text-3xl md:text-4xl leading-[1.12]">
          Propuestas para <span class="accent">próximos clientes</span>
        </h2>
      </div>
      <p class="md:col-span-5 text-muted leading-relaxed" data-reveal style="--d: 0.1s">
        Prototipos funcionando que preparé para negocios de la zona. Todavía no están publicados con su dominio, pero podés recorrerlos.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12">
      {PROTOTYPES.map((p, i) => (
        <article class="project group" data-reveal style={`--d: ${(i % 3) * 0.08}s`}>
          <a href={p.url} target="_blank" rel="noopener noreferrer" class="block" aria-label={`Ver prototipo de ${p.client} (se abre en otra pestaña)`}>
            <div class="shot aspect-[16/11]">
              <img
                src={p.shotDesktop}
                alt={`Prototipo de la web de ${p.client}`}
                class="shot-desktop absolute inset-0 w-full h-full object-cover object-top"
                loading="lazy"
                decoding="async"
                width="1440"
                height="900"
              />
              <img src={p.shotMobile} alt="" class="shot-phone !w-[22%] !border-[3px]" loading="lazy" decoding="async" width="390" height="844" />
              <span class="absolute top-3 left-3 text-[11px] uppercase tracking-[0.12em] px-2.5 py-1 rounded-full bg-black/70 text-white backdrop-blur">Prototipo</span>
            </div>
          </a>
          <div class="mt-5 flex items-start justify-between gap-4">
            <div>
              <h3 class="text-lg leading-snug">{p.client}</h3>
              <p class="mt-1 text-sm text-muted">{p.sector} · {p.location}</p>
              <p class="mt-3 text-sm text-muted leading-relaxed">{p.summary}</p>
            </div>
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class="project-arrow shrink-0 w-10 h-10 rounded-full border border-line grid place-items-center"
              aria-label={`Abrir prototipo de ${p.client}`}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
