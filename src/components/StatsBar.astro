---
const stats = [
  {
    number: "+18K",
    label: "Audiencia alcanzada",
    detail: "Clientes comprando en webs desarrolladas"
  },
  {
    number: "<0.5s",
    label: "Velocidad de carga móvil",
    detail: "Tus clientes no esperan ni se van a la competencia"
  },
  {
    number: "100%",
    label: "Pedidos a tu WhatsApp",
    detail: "Ventas y consultas directas en tu celular"
  },
  {
    number: "0%",
    label: "Comisiones por venta",
    detail: "Todo lo que vendés en tu web es 100% tuyo"
  }
];
---

<section class="py-8 bg-dark-900/60 border-y border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {stats.map(stat => (
        <div class="flex flex-col items-center sm:items-start text-center sm:text-left">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gradient-emerald tracking-tight mb-1">
            {stat.number}
          </div>
          <div class="text-sm font-bold text-white mb-0.5">
            {stat.label}
          </div>
          <div class="text-xs text-slate-400 max-w-[200px]">
            {stat.detail}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
