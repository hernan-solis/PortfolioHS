---
import { FEATURED_PROJECTS } from '../data/projects';
---

<section id="trabajos" class="pt-24 md:pt-36 pb-16 md:pb-20">
  <div class="wrap">
    <div class="grid md:grid-cols-12 gap-6 md:gap-10 items-end mb-14 md:mb-20">
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">Trabajos</p>
        <h2 class="mt-5 text-3xl sm:text-4xl md:text-5xl leading-[1.1]">
          Sitios que ya están <span class="accent">vendiendo</span>
        </h2>
      </div>
      <p class="md:col-span-5 text-muted leading-relaxed" data-reveal style="--d: 0.1s">
        Webs en línea para clientes reales, de una tienda de barrio a una empresa de reciclaje industrial. Entrá y probalas.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-x-8 gap-y-16 md:gap-y-20">
      {FEATURED_PROJECTS.map((p, i) => (
        <article
          class:list={['project group', i === 0 && 'md:col-span-2']}
          data-reveal
          style={`--d: ${(i % 2) * 0.12}s`}
        >
          <a href={p.url} target="_blank" rel="noopener noreferrer" class="block" aria-label={`Ver ${p.client} (se abre en otra pestaña)`}>
            <div class:list={['shot', i === 0 ? 'aspect-[16/10] md:aspect-[16/8]' : 'aspect-[16/11]']}>
              <img
                src={p.shotDesktop}
                alt={`Página de inicio de ${p.client}`}
                class="shot-desktop absolute inset-0 w-full h-full object-cover object-top"
                loading="lazy"
                decoding="async"
                width="1440"
                height="900"
              />
              <img
                src={p.shotMobile}
                alt=""
                class="shot-phone hidden sm:block"
                loading="lazy"
                decoding="async"
                width="390"
                height="844"
              />
            </div>
          </a>

          <div class="mt-6 flex items-start justify-between gap-6">
            <div>
              <p class="text-sm text-muted">
                <span class="text-fg font-medium">{p.client}</span>
                <span class="mx-2 opacity-50">/</span>{p.sector} · {p.location}
              </p>
              <h3 class:list={['mt-3 leading-snug', i === 0 ? 'text-xl md:text-3xl max-w-3xl' : 'text-xl md:text-2xl']}>
                {p.title}
              </h3>
              <p class="mt-3 text-muted leading-relaxed max-w-2xl">{p.summary}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {p.highlights.map((h) => (
                  <li class="text-xs px-3 py-1.5 rounded-full border border-line text-muted">{h}</li>
                ))}
              </ul>
            </div>
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class="project-arrow shrink-0 w-12 h-12 rounded-full border border-line grid place-items-center"
              aria-label={`Abrir ${p.displayUrl}`}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
