---
import { FEATURED_PROJECTS } from '../data/projects';
import { getWhatsAppLink } from '../data/siteConfig';

const contactWaProject = getWhatsAppLink("Hola Hernán, estuve viendo los sitios de Tu iPhone Zona Norte y Ariel Stefanazzi. Me gustaría conversar sobre una web para mi negocio.");
---

<section id="proyectos" class="py-16 md:py-24 border-t border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-4">
      <div>
        <div class="font-mono text-[11px] tracking-widest uppercase text-zinc-500 mb-2">
          01 // Casos de estudio
        </div>
        <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tightest">
          Proyectos en producción
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-md font-normal leading-relaxed">
        Sitios y aplicaciones web desarrolladas a medida. En funcionamiento continuo, atendiendo clientes reales y recibiendo consultas a diario.
      </p>
    </div>

    <!-- Case Studies Stack -->
    <div class="space-y-10 sm:space-y-14">
      {FEATURED_PROJECTS.map((project, idx) => (
        <article class="bento-card p-6 sm:p-10 relative overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            <!-- Details Column (7 cols) -->
            <div class="lg:col-span-7 flex flex-col justify-between">
              <div>
                
                <!-- Category and Status -->
                <div class="flex flex-wrap items-center gap-3 mb-4">
                  <span class="font-mono text-[11px] text-zinc-400 bg-zinc-900 px-3 py-1 rounded-md border border-white/[0.06]">
                    {project.category}
                  </span>
                  <div class="flex items-center gap-1.5 text-[11px] font-mono text-emerald-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>Online</span>
                  </div>
                </div>

                <!-- Title -->
                <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-3">
                  {project.title}
                </h3>

                <!-- Description -->
                <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-6">
                  {project.description}
                </p>

                <!-- Key highlights -->
                <div class="p-4 rounded-xl bg-zinc-900/70 border border-white/[0.06] mb-6">
                  <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-wider mb-2">
                    Objetivo & Solución técnica:
                  </div>
                  <p class="text-xs text-zinc-300 leading-relaxed">
                    {project.businessImpact}
                  </p>
                </div>

                <!-- Feature tags -->
                <div class="flex flex-wrap gap-2 mb-6">
                  {project.features.slice(0, 3).map(feature => (
                    <span class="text-[11px] text-zinc-300 bg-zinc-900/60 px-2.5 py-1 rounded-md border border-white/[0.05]">
                      {feature}
                    </span>
                  ))}
                </div>

              </div>

              <!-- Action & Tech -->
              <div class="pt-6 border-t border-white/[0.06] flex flex-wrap items-center justify-between gap-4">
                <a 
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-zinc-100 hover:bg-white text-zinc-950 font-semibold text-xs tracking-tight transition-all"
                >
                  <span>Visitar {project.displayUrl}</span>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17l9.2-9.2M17 17V8H8"/>
                  </svg>
                </a>

                <div class="text-[11px] font-mono text-zinc-500">
                  {project.techStack.join(" • ")}
                </div>
              </div>

            </div>

            <!-- Preview Card (5 cols) -->
            <div class="lg:col-span-5">
              <a 
                href={project.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="block relative rounded-xl overflow-hidden bg-zinc-900 border border-white/10 group cursor-pointer"
              >
                <!-- Browser Header Bar -->
                <div class="flex items-center justify-between px-3.5 py-2.5 bg-zinc-950/80 border-b border-white/[0.06]">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                  </div>
                  <span class="font-mono text-[10px] text-zinc-500 truncate max-w-[180px]">
                    https://{project.displayUrl}
                  </span>
                  <div class="w-4"></div>
                </div>

                <!-- Image container with subtle zoom -->
                <div class="aspect-[4/3] w-full bg-zinc-950 flex items-center justify-center p-4 overflow-hidden relative">
                  <img 
                    src={project.image} 
                    alt={`Sitio web ${project.title}`}
                    class="w-full h-full object-contain rounded transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                    <span class="text-xs font-mono font-medium text-white px-3 py-1.5 rounded-md bg-zinc-900/90 border border-white/20">
                      Abrir sitio web ↗
                    </span>
                  </div>
                </div>
              </a>
            </div>

          </div>
        </article>
      ))}
    </div>

    <!-- Minimalist bottom invitation -->
    <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-zinc-900/50 border border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center sm:text-left">
        <h4 class="text-base font-semibold text-white">¿Tenés un negocio o proyecto en mente?</h4>
        <p class="text-xs text-zinc-400">Analizamos tu caso y definimos la solución exacta que necesitás para empezar a vender.</p>
      </div>
      <a 
        href={contactWaProject}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-zinc-100 hover:bg-white text-zinc-950 font-semibold text-xs tracking-tight transition-all flex-shrink-0"
      >
        <span>Escribime por WhatsApp</span>
        <svg class="w-3.5 h-3.5 fill-current text-whatsapp" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
      </a>
    </div>

  </div>
</section>
