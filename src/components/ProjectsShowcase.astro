---
import { FEATURED_PROJECTS } from '../data/projects';
import { getWhatsAppLink } from '../data/siteConfig';

const contactWaProject = getWhatsAppLink("¡Hola Hernán! Vi tus proyectos (Tu iPhone Zona Norte y Ariel Stefanazzi) y me gustaría una web similar para mi negocio.");
---

<section id="trabajos" class="py-20 md:py-32 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs sm:text-sm text-cyan-300 font-semibold mb-4">
        <span>💼 Experiencia Comprobada</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        Trabajos reales para <br class="hidden sm:inline" />
        <span class="text-gradient-cyan">negocios que ya están vendiendo</span>
      </h2>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        No muestro maquetas ficticias. Estos son proyectos reales en producción, alojados en la nube y generando clientes todos los días.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="flex flex-col gap-12 sm:gap-16">
      
      {FEATURED_PROJECTS.map((project, index) => {
        const isEven = index % 2 === 1;
        return (
          <article class="glass-card rounded-3xl p-6 sm:p-10 border border-slate-800/80 shadow-card hover:border-slate-700 transition-all duration-300">
            <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-center ${isEven ? 'lg:flex-row-reverse' : ''}`}>
              
              <!-- Content Column (7 cols) -->
              <div class={`lg:col-span-7 flex flex-col justify-center ${isEven ? 'lg:order-2' : 'lg:order-1'}`}>
                
                <!-- Category & Status Badge -->
                <div class="flex flex-wrap items-center gap-3 mb-4">
                  <span class="px-3 py-1 rounded-full bg-brand-primary/10 border border-brand-primary/30 text-xs font-bold text-brand-primary">
                    {project.badge}
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-medium bg-emerald-950/60 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Sitio Online en Vivo
                  </span>
                </div>

                <!-- Project Title & Client -->
                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight mb-2">
                  {project.title}
                </h3>
                <p class="text-brand-cyan text-sm sm:text-base font-semibold mb-4">
                  {project.category}
                </p>

                <!-- Description -->
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                  {project.description}
                </p>

                <!-- Business Impact Box -->
                <div class="p-4 rounded-2xl bg-dark-900/80 border border-slate-800 mb-6">
                  <div class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-1 flex items-center gap-1.5">
                    <span>📈 Impacto Real en el Negocio:</span>
                  </div>
                  <p class="text-sm font-medium text-slate-200">
                    {project.businessImpact}
                  </p>
                </div>

                <!-- Feature Bullets (Mobile-friendly list) -->
                <div class="space-y-2 mb-8">
                  <div class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-2">
                    Funcionalidades Clave:
                  </div>
                  {project.features.slice(0, 4).map(feature => (
                    <div class="flex items-start gap-2 text-xs sm:text-sm text-slate-300">
                      <svg class="w-4 h-4 text-brand-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feature}</span>
                    </div>
                  ))}
                </div>

                <!-- Metrics Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-4 border-y border-slate-800/80 mb-8">
                  {project.metrics.map(metric => (
                    <div>
                      <div class="text-lg sm:text-xl font-extrabold text-white">
                        {metric.value}
                      </div>
                      <div class="text-[11px] text-slate-400 font-medium">
                        {metric.label}
                      </div>
                    </div>
                  ))}
                </div>

                <!-- Action Link Buttons -->
                <div class="flex flex-wrap items-center gap-4">
                  <a 
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-brand-primary to-brand-cyan hover:from-emerald-400 hover:to-cyan-400 text-dark-950 font-bold text-sm shadow-glow transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
                  >
                    <span>Ver Sitio en Vivo ({project.displayUrl})</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                  <span class="text-xs text-slate-500 font-mono">
                    Tecnología: {project.techStack.join(" • ")}
                  </span>
                </div>

              </div>

              <!-- Visual Preview Column (5 cols) -->
              <div class={`lg:col-span-5 ${isEven ? 'lg:order-1' : 'lg:order-2'}`}>
                <div class="relative group">
                  <div class="absolute -inset-1 bg-gradient-to-r from-brand-primary to-brand-cyan rounded-3xl blur opacity-25 group-hover:opacity-50 transition duration-500"></div>
                  
                  <div class="relative rounded-2xl overflow-hidden bg-dark-900 border border-slate-800 shadow-2xl">
                    <!-- Browser-like Top Bar -->
                    <div class="flex items-center justify-between px-4 py-3 bg-dark-950/80 border-b border-slate-800/80">
                      <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
                        <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
                        <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
                      </div>
                      <div class="text-[11px] font-mono text-slate-400 bg-dark-900 px-3 py-1 rounded-md border border-slate-800/80 flex items-center gap-1.5 truncate max-w-[200px]">
                        <svg class="w-3 h-3 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                        </svg>
                        <span class="truncate">https://{project.displayUrl}</span>
                      </div>
                      <div class="w-4"></div>
                    </div>

                    <!-- Image Display -->
                    <div class="relative aspect-video sm:aspect-[4/3] w-full bg-slate-900 overflow-hidden flex items-center justify-center p-4">
                      <img 
                        src={project.image} 
                        alt={`Captura del sitio web ${project.title}`}
                        class="w-full h-full object-contain rounded-lg group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                        onerror="this.src='/assets/img/imgAppWebCatalogo.png'"
                      />
                      
                      <!-- Overlay button on hover -->
                      <a 
                        href={project.url} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="absolute inset-0 bg-dark-950/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-2 text-white font-bold text-sm backdrop-blur-sm"
                      >
                        <span class="px-4 py-2 rounded-xl bg-brand-primary text-dark-950 font-bold">
                          Abrir {project.displayUrl} ↗
                        </span>
                      </a>
                    </div>

                  </div>
                </div>
              </div>

            </div>
          </article>
        );
      })}

    </div>

    <!-- Direct Pitch Card -->
    <div class="mt-16 sm:mt-20 p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-dark-900 to-dark-850 border border-emerald-500/30 text-center relative overflow-hidden shadow-glow">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-brand-primary/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
        ¿Querés que tu negocio tenga una presencia web así de potente?
      </h3>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto mb-8">
        Hagamos que tus clientes no duden al buscarte. Coordinamos los detalles por WhatsApp y en pocos días tenés tu página funcionando.
      </p>
      
      <a 
        href={contactWaProject}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-whatsapp hover:bg-whatsapp-hover text-white font-extrabold text-base shadow-whatsapp transition-all duration-300 hover:scale-[1.02]"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>Consultar por Mi Proyecto por WhatsApp</span>
      </a>
    </div>

  </div>
</section>
