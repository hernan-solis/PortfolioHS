---
const steps = [
  {
    step: "01",
    title: "Diagnóstico Rápido",
    desc: "Nos escribimos por WhatsApp o tomamos un café en Zona Norte. Me mostrás tu negocio, tus productos y definimos qué necesitás.",
    icon: "☕"
  },
  {
    step: "02",
    title: "Diseño & Estrategia",
    desc: "Diseñamos la estructura enfocada en convertir visitas en ventas: textos persuasivos, botones de WhatsApp visibles y catálogo ágil.",
    icon: "🎨"
  },
  {
    step: "03",
    title: "Programación & Pruebas",
    desc: "Construyo el sitio con tecnología moderna. Te paso un enlace de prueba para que navegues y compres como si fueras tu propio cliente.",
    icon: "💻"
  },
  {
    step: "04",
    title: "¡Lanzamiento y Ventas!",
    desc: "Conectamos tu dominio (.com o .com.ar), configuramos Google SEO y tu web queda abierta al público facturando las 24 horas.",
    icon: "🚀"
  }
];
---

<section class="py-20 md:py-28 bg-dark-900/30 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs sm:text-sm text-cyan-300 font-semibold mb-4">
        <span>📋 Simple y sin complicaciones</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        Tu página lista en <br class="hidden sm:inline" />
        <span class="text-gradient-cyan">4 pasos transparentes</span>
      </h2>
      <p class="text-slate-300 text-sm sm:text-base">
        Sin contratos confusos ni meses de espera. Un proceso directo, claro y con comunicación constante.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((item, idx) => (
        <div class="glass-card rounded-2xl p-6 border border-slate-800 relative flex flex-col justify-between hover:border-slate-700 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-2.5 rounded-xl bg-dark-950/70 border border-slate-800">
                {item.icon}
              </span>
              <span class="text-3xl font-extrabold text-slate-700/80 font-mono">
                {item.step}
              </span>
            </div>
            
            <h3 class="text-lg font-bold text-white mb-2">
              {item.title}
            </h3>
            
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center gap-2 text-[11px] text-brand-primary font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-primary"></span>
            <span>Paso {idx + 1} de 4</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
