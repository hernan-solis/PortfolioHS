---
import { SITE_CONFIG } from '../data/siteConfig';
---

<div id="contact-widget" class="fixed bottom-5 right-5 z-50 flex flex-col items-end gap-3">
  
  <!-- Panel -->
  <div 
    id="widget-panel" 
    class="hidden w-[360px] max-w-[calc(100vw-2.5rem)] rounded-2xl overflow-hidden border border-white/10 shadow-2xl transition-all duration-300"
    style="background: linear-gradient(135deg, rgba(8, 12, 28, 0.95), rgba(3, 7, 18, 0.98)); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);"
  >
    
    <!-- Header -->
    <div class="flex items-center justify-between px-5 pt-5 pb-3">
      <div>
        <h3 class="text-white font-semibold text-base">¿Te ayudo con tu web?</h3>
        <p class="text-slate-400 text-xs mt-0.5">Elegí una opción y te respondo por correo</p>
      </div>
      <button 
        id="widget-close" 
        class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition-colors" 
        aria-label="Cerrar"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="h-px bg-white/[0.06] mx-5"></div>

    <!-- Step 1: Options -->
    <div id="widget-options" class="px-5 py-4 flex flex-col gap-2">
      <button class="widget-opt flex items-center gap-3 w-full text-left px-4 py-3 rounded-xl text-xs sm:text-sm text-slate-300 bg-white/[0.04] border border-white/[0.06] hover:bg-white/[0.08] hover:border-teal-500/30 hover:text-white transition-all" data-opt="1" data-msg="Quiero cotizar el desarrollo de un sitio web o catálogo para mi negocio.">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
        </svg>
        <span>Quiero cotizar un proyecto</span>
      </button>

      <button class="widget-opt flex items-center gap-3 w-full text-left px-4 py-3 rounded-xl text-xs sm:text-sm text-slate-300 bg-white/[0.04] border border-white/[0.06] hover:bg-white/[0.08] hover:border-cyan-500/30 hover:text-white transition-all" data-opt="2" data-msg="Necesito una plataforma digital, software o sistema a medida.">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25Z" />
        </svg>
        <span>Necesito un sistema o software</span>
      </button>

      <button class="widget-opt flex items-center gap-3 w-full text-left px-4 py-3 rounded-xl text-xs sm:text-sm text-slate-300 bg-white/[0.04] border border-white/[0.06] hover:bg-white/[0.08] hover:border-violet-500/30 hover:text-white transition-all" data-opt="3" data-msg="Quiero rediseñar o acelerar un sitio web que ya tengo en funcionamiento.">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
        </svg>
        <span>Quiero rediseñar o acelerar mi web</span>
      </button>

      <button class="widget-opt flex items-center gap-3 w-full text-left px-4 py-3 rounded-xl text-xs sm:text-sm text-slate-300 bg-white/[0.04] border border-white/[0.06] hover:bg-white/[0.08] hover:border-slate-500/30 hover:text-white transition-all" data-opt="4" data-msg="Tengo una consulta técnica sobre mi negocio.">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
        </svg>
        <span>Solo tengo una consulta</span>
      </button>
    </div>

    <!-- Step 2: Form View -->
    <div id="widget-form-view" class="hidden px-5 py-4">
      <div class="rounded-xl p-3 mb-3 bg-teal-500/10 border border-teal-500/20">
        <p id="widget-reply-text" class="text-xs text-slate-300 leading-relaxed"></p>
      </div>

      <form id="widget-form" action={SITE_CONFIG.contactFormEndpoint} method="POST" class="flex flex-col gap-2.5">
        <input type="hidden" name="access_key" value={SITE_CONFIG.web3formsKey} />
        <input type="hidden" name="subject" value="Consulta rápida - Asistente Portfolio Hernán Solis" />
        <input type="hidden" name="from_name" value="Portfolio Hernán Solis" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

        <input 
          type="text" 
          name="name" 
          required 
          placeholder="Tu nombre" 
          class="w-full px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-xs text-white placeholder-slate-500 focus:outline-none focus:border-teal-400 transition-colors"
        />
        
        <input 
          type="email" 
          name="email" 
          required 
          placeholder="tu@email.com" 
          class="w-full px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-xs text-white placeholder-slate-500 focus:outline-none focus:border-teal-400 transition-colors"
        />

        <textarea 
          id="widget-message"
          name="message" 
          rows="3" 
          required 
          placeholder="Contame detalles de lo que necesitás..." 
          class="w-full px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-xs text-white placeholder-slate-500 focus:outline-none focus:border-teal-400 transition-colors resize-none"
        ></textarea>

        <button 
          type="submit" 
          id="widget-submit"
          class="btn btn-primary btn-sm w-full py-2.5 text-xs font-semibold"
        >
          <span>Enviar mensaje por correo</span>
        </button>

        <p id="widget-status" class="hidden text-xs text-center"></p>
      </form>

      <button 
        id="widget-back" 
        class="mt-2 w-full text-center text-xs text-slate-500 hover:text-slate-300 transition-colors py-1"
      >
        ← Volver a las opciones
      </button>
    </div>

    <!-- Step 3: Success View -->
    <div id="widget-success" class="hidden px-5 py-8 text-center">
      <div class="w-12 h-12 mx-auto mb-3 rounded-full grid place-items-center bg-teal-500/10 border border-teal-500/30">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
      </div>
      <p class="text-sm text-slate-200 font-semibold">¡Mensaje enviado!</p>
      <p class="text-xs text-slate-400 mt-1">Te responderé a tu correo a la brevedad.</p>
    </div>

  </div>

  <!-- FAB trigger -->
  <button 
    id="widget-fab" 
    class="w-14 h-14 rounded-full flex items-center justify-center text-white cursor-pointer shadow-lg hover:scale-105 active:scale-95 transition-all duration-300 border border-teal-400/40"
    style="background: linear-gradient(135deg, #14b8a6, #0d9488, #0f766e); box-shadow: 0 4px 20px rgba(20, 184, 166, 0.4);"
    aria-label="Abrir asistente de contacto por correo"
  >
    <!-- Chat Icon -->
    <svg id="fab-icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
    </svg>
    <!-- Close Icon -->
    <svg id="fab-icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

</div>

<script>
  const fab = document.getElementById('widget-fab');
  const panel = document.getElementById('widget-panel');
  const closeBtn = document.getElementById('widget-close');
  const iconOpen = document.getElementById('fab-icon-open');
  const iconClose = document.getElementById('fab-icon-close');

  const optionsView = document.getElementById('widget-options');
  const formView = document.getElementById('widget-form-view');
  const successView = document.getElementById('widget-success');
  const backBtn = document.getElementById('widget-back');
  const replyText = document.getElementById('widget-reply-text');
  const messageInput = document.getElementById('widget-message') as HTMLTextAreaElement;
  const form = document.getElementById('widget-form') as HTMLFormElement;
  const submitBtn = document.getElementById('widget-submit') as HTMLButtonElement;
  const status = document.getElementById('widget-status');

  const replies: Record<string, string> = {
    "1": "Genial. Contame sobre tu negocio y qué tipo de catálogo o web buscás para armarte una propuesta a medida.",
    "2": "Perfecto. Podemos desarrollar sistemas web o plataformas a medida. Contame las funciones principales que necesitás.",
    "3": "Excelente. Podemos optimizar la velocidad y modernizar el diseño de tu sitio actual.",
    "4": "Sin compromiso. Escribime tu duda y te respondo a la brevedad por correo."
  };

  function toggleWidget() {
    const isHidden = panel?.classList.contains('hidden');
    if (isHidden) {
      panel?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    } else {
      panel?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  }

  fab?.addEventListener('click', toggleWidget);
  closeBtn?.addEventListener('click', toggleWidget);

  document.querySelectorAll('.widget-opt').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const opt = target.getAttribute('data-opt') || "1";
      const defaultMsg = target.getAttribute('data-msg') || "";

      if (replyText) replyText.textContent = replies[opt] || replies["1"];
      if (messageInput) messageInput.value = defaultMsg;

      optionsView?.classList.add('hidden');
      formView?.classList.remove('hidden');
      successView?.classList.add('hidden');
    });
  });

  backBtn?.addEventListener('click', () => {
    formView?.classList.add('hidden');
    optionsView?.classList.remove('hidden');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;
    submitBtn.disabled = true;
    submitBtn.innerHTML = `<span>Enviando...</span>`;

    const data = new FormData(form);
    const json = JSON.stringify(Object.fromEntries(data));

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: json
      });
      const result = await response.json().catch(() => null);

      if (response.status === 200 && result && result.success) {
        form.reset();
        formView?.classList.add('hidden');
        successView?.classList.remove('hidden');
      } else {
        if (status) {
          status.textContent = result?.message || "Error al enviar. Por favor escribime a hernansolis94@icloud.com";
          status.className = "text-xs text-rose-400 text-center block pt-1";
        }
      }
    } catch {
      if (status) {
        status.textContent = "Error de conexión. Escribime a hernansolis94@icloud.com";
        status.className = "text-xs text-rose-400 text-center block pt-1";
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = `<span>Enviar mensaje por correo</span>`;
    }
  });
</script>
