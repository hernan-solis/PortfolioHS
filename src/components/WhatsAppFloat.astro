---
import { getWhatsAppLink } from '../data/siteConfig';

const floatWaLink = getWhatsAppLink("¡Hola Hernán! Vi tu página web y quiero consultarte por el desarrollo de un sitio web.");
---

<div class="fixed bottom-6 right-6 z-50 flex items-center gap-3">
  
  <!-- Tooltip Bubble (hidden on smallest screens, visible on mobile scroll or hover) -->
  <a 
    href={floatWaLink}
    target="_blank"
    rel="noopener noreferrer"
    class="hidden sm:flex items-center gap-2 px-3.5 py-2 rounded-2xl glass-card border border-whatsapp/40 text-xs font-bold text-white shadow-xl hover:border-whatsapp transition-all duration-300 transform hover:-translate-x-1"
  >
    <span class="w-2 h-2 rounded-full bg-whatsapp animate-ping"></span>
    <span>¿Hablamos de tu web?</span>
  </a>

  <!-- Floating Circle Button with Ripple Effect -->
  <a 
    href={floatWaLink}
    target="_blank"
    rel="noopener noreferrer"
    class="relative group w-14 h-14 rounded-full bg-whatsapp text-white flex items-center justify-center shadow-whatsapp hover:bg-whatsapp-hover transition-all duration-300 transform hover:scale-110 active:scale-95"
    aria-label="Contactar a Hernán Solís por WhatsApp"
  >
    <!-- Ripple animation -->
    <span class="absolute -inset-1 rounded-full bg-whatsapp/40 animate-ping pointer-events-none group-hover:opacity-0"></span>

    <!-- WhatsApp SVG Icon -->
    <svg class="w-7 h-7 fill-current relative z-10" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
    </svg>
  </a>

</div>
