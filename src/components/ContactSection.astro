---
import { SITE_CONFIG } from '../data/siteConfig';
---

<section id="contacto" class="relative py-24 md:py-36 border-t border-line overflow-hidden">
  <div class="wrap grid md:grid-cols-12 gap-14 md:gap-16">
    <div class="md:col-span-6" data-reveal>
      <p class="eyebrow">Contacto</p>
      <h2 class="mt-5 text-4xl sm:text-5xl md:text-6xl leading-[1.05]">
        Contame qué <span class="accent">necesitás</span>
      </h2>
      <p class="mt-6 text-muted leading-relaxed max-w-md text-[1.05rem]">
        Escribime con tu idea, aunque sea un borrador. Te respondo en el día con preguntas o un presupuesto.
      </p>

      <a href={`mailto:${SITE_CONFIG.email}`} class="mt-10 inline-flex items-center gap-3 font-display text-lg sm:text-xl md:text-2xl break-all group">
        <span class="u-link">{SITE_CONFIG.email}</span>
        <svg class="shrink-0 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <form
      id="contact-form"
      action={SITE_CONFIG.contactFormEndpoint}
      method="POST"
      class="md:col-span-6 space-y-6"
      data-reveal
      style="--d: 0.1s"
    >
      <input type="hidden" name="access_key" value={SITE_CONFIG.web3formsKey} />
      <input type="hidden" name="subject" value="Nuevo proyecto - Portfolio Hernán Solis" />
      <input type="hidden" name="from_name" value="Portfolio Hernán Solis" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

      <div class="grid sm:grid-cols-2 gap-6">
        <label class="block">
          <span class="text-xs uppercase tracking-[0.14em] text-muted">Nombre</span>
          <input type="text" name="name" required autocomplete="name" class="field" placeholder="Tu nombre o empresa" />
        </label>
        <label class="block">
          <span class="text-xs uppercase tracking-[0.14em] text-muted">Email</span>
          <input type="email" name="email" required autocomplete="email" class="field" placeholder="tu@email.com" />
        </label>
      </div>

      <fieldset>
        <legend class="text-xs uppercase tracking-[0.14em] text-muted mb-3">Qué necesitás</legend>
        <div class="flex flex-wrap gap-2">
          {['Página web', 'Catálogo / tienda', 'Sistema a medida', 'Rediseño', 'Otra cosa'].map((opt) => (
            <label class="cursor-pointer">
              <input type="radio" name="tipo" value={opt} class="peer sr-only" />
              <span class="block text-sm px-4 py-2 rounded-full border border-line text-muted transition-colors peer-checked:bg-accent peer-checked:text-[var(--accent-ink)] peer-checked:border-transparent peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-[var(--accent)] hover:border-[var(--line-strong)] hover:text-fg">
                {opt}
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <label class="block">
        <span class="text-xs uppercase tracking-[0.14em] text-muted">Mensaje</span>
        <textarea name="message" rows="4" required class="field resize-none" placeholder="Contame sobre tu negocio y qué te gustaría lograr"></textarea>
      </label>

      <div class="flex flex-col sm:flex-row sm:items-center gap-4 pt-2">
        <button type="submit" id="contact-submit" class="btn btn-solid">
          <span>Enviar mensaje</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <p id="contact-status" class="text-sm" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const fallback = 'Hubo un error al enviar. Escribime directo a hernansolis94@icloud.com';

  if (form && status && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      const label = submitBtn.querySelector('span');
      const originalText = label?.textContent ?? '';
      if (label) label.textContent = 'Enviando...';
      status.textContent = '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const result = await response.json().catch(() => null);

        if (response.ok && result?.success) {
          form.reset();
          status.textContent = '¡Listo! Te respondo a la brevedad.';
          status.style.color = 'var(--accent)';
        } else {
          status.textContent = result?.message || fallback;
          status.style.color = '#f87171';
        }
      } catch {
        status.textContent = fallback;
        status.style.color = '#f87171';
      } finally {
        submitBtn.disabled = false;
        if (label) label.textContent = originalText;
      }
    });
  }
</script>
