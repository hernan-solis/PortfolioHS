---
import { SITE_CONFIG } from '../data/siteConfig';
---

<section id="contacto" class="section relative overflow-hidden py-20 md:py-28 border-t border-white/[0.06]">
  
  <!-- Ambient glows -->
  <div class="bg-orb w-[400px] h-[400px] -bottom-20 -right-20 bg-teal-500/[0.06]" style="animation-delay: 4s;"></div>
  <div class="bg-orb w-[300px] h-[300px] -top-10 -left-20 bg-violet-500/[0.05]" style="animation-delay: 7s;"></div>

  <div class="container-safe relative z-10">
    <div class="max-w-3xl mx-auto">
      
      <div data-reveal class="card text-center py-10 px-6 sm:px-12 relative overflow-hidden" style="background: linear-gradient(135deg, rgba(20,184,166,0.06), rgba(34,211,238,0.03) 40%, rgba(139,92,246,0.05)); border-color: rgba(20,184,166,0.2); box-shadow: 0 8px 40px rgba(0,0,0,0.5), 0 0 60px rgba(20,184,166,0.06);">
        
        <!-- Background radial glow -->
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[400px] h-[200px] rounded-full" style="background: radial-gradient(ellipse, rgba(20,184,166,0.1) 0%, transparent 70%);"></div>
        </div>

        <div class="relative z-10">
          
          <!-- Monogram Badge -->
          <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-slate-900/90 border border-teal-500/30 flex items-center justify-center font-mono font-bold text-sm text-teal-300 shadow-[0_0_16px_rgba(20,184,166,0.2)]">
            HS
          </div>

          <h2 class="text-3xl sm:text-4xl font-semibold text-white tracking-tight">
            ¿Tenés un proyecto en mente?
          </h2>

          <p class="mt-3 text-slate-400 max-w-lg mx-auto text-sm sm:text-base leading-relaxed">
            Contame qué querés construir y vemos cómo hacerlo realidad. Respuesta directa por correo electrónico.
          </p>

          <!-- Contact Form -->
          <form id="contact-form" action={SITE_CONFIG.contactFormEndpoint} method="POST" class="mt-8 max-w-md mx-auto space-y-4 text-left">
            <!-- FormSubmit options -->
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_subject" value="Nuevo proyecto - Portfolio Hernán Solis" />
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-medium text-slate-300 mb-1.5">
                  Nombre
                </label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="name" 
                  required 
                  class="w-full px-4 py-2.5 bg-slate-900/80 border border-slate-700/80 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200" 
                  placeholder="Tu nombre o empresa"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-medium text-slate-300 mb-1.5">
                  Correo electrónico
                </label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="email" 
                  required 
                  class="w-full px-4 py-2.5 bg-slate-900/80 border border-slate-700/80 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200" 
                  placeholder="tu@email.com"
                />
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-medium text-slate-300 mb-1.5">
                Mensaje
              </label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="4" 
                required 
                class="w-full px-4 py-2.5 bg-slate-900/80 border border-slate-700/80 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200 resize-none" 
                placeholder="Contame sobre tu proyecto o idea..."
              ></textarea>
            </div>

            <button 
              type="submit" 
              id="contact-submit" 
              class="btn btn-primary btn-lg w-full group"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
              </svg>
              <span>Enviar mensaje</span>
            </button>

            <p id="contact-status" class="hidden text-sm text-center pt-2 font-medium"></p>
          </form>

          <p class="mt-8 text-xs text-slate-500">
            <span>También podés escribirme directamente a</span>
            <a 
              href={`mailto:${SITE_CONFIG.email}`} 
              class="text-teal-400 hover:text-teal-300 font-medium hover:underline transition-colors ml-1"
            >
              {SITE_CONFIG.email}
            </a>
          </p>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;

  if (form && status && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = `<span>Enviando...</span>`;

      const data = new FormData(form);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: {
            'Accept': 'application/json'
          }
        });

        const result = await response.json().catch(() => null);

        if (response.ok) {
          form.reset();
          if (result && typeof result.message === 'string' && result.message.toLowerCase().includes('activate')) {
            status.textContent = "¡Casi listo! FormSubmit envió un correo a Hernán para activar el formulario por primera vez.";
          } else {
            status.textContent = "¡Mensaje enviado con éxito! Te responderé a la brevedad.";
          }
          status.className = "text-sm text-center pt-2 font-medium text-teal-400 block";
        } else {
          status.textContent = (result && result.message) ? result.message : "Hubo un error al enviar el formulario. Por favor escribime a hernansolis94@icloud.com";
          status.className = "text-sm text-center pt-2 font-medium text-rose-400 block";
        }
      } catch (err) {
        status.textContent = "Hubo un error de conexión. Por favor escribime a hernansolis94@icloud.com";
        status.className = "text-sm text-center pt-2 font-medium text-rose-400 block";
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  }
</script>
