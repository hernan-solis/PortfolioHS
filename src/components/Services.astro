---
const services = [
  {
    num: '01',
    title: 'Página web para tu negocio',
    desc: 'Un sitio claro y rápido que explica qué hacés, muestra tus trabajos y lleva al cliente a escribirte. Pensado para aparecer en Google cuando te buscan en tu zona.',
    items: ['Web institucional o landing', 'Botón de contacto y WhatsApp', 'Ficha en Google Maps'],
  },
  {
    num: '02',
    title: 'Catálogo online con cotizador',
    desc: 'Tus productos o servicios con precios y opciones. El cliente arma su pedido y te llega listo para cerrar la venta, sin pagar comisiones a ninguna plataforma.',
    items: ['Variantes: modelos, talles, colores', 'Cotización al instante', '0% de comisión por venta'],
  },
  {
    num: '03',
    title: 'Sistemas a medida',
    desc: 'Cuando una planilla de Excel ya no alcanza: turnos, stock, clientes o paneles internos, hechos para cómo trabaja tu equipo.',
    items: ['Paneles de administración', 'Bases de datos SQL', 'C# / .NET y APIs'],
  },
];

const included = ['Diseño para celular y computadora', 'Dominio .com.ar configurado', 'SEO local en Google', 'El código es tuyo'];
---

<section id="servicios" class="py-24 md:py-36 border-t border-line">
  <div class="wrap">
    <div class="max-w-2xl mb-14 md:mb-20" data-reveal>
      <p class="eyebrow">Servicios</p>
      <h2 class="mt-5 text-3xl sm:text-4xl md:text-5xl leading-[1.1]">
        Qué puedo <span class="accent">hacer</span> por tu negocio
      </h2>
    </div>

    <div class="grid md:grid-cols-3 border-t border-line">
      {services.map((s, i) => (
        <article
          class="group relative py-10 md:py-12 md:px-8 first:md:pl-0 last:md:pr-0 border-b md:border-b-0 md:border-l first:md:border-l-0 border-line"
          data-reveal
          style={`--d: ${i * 0.1}s`}
        >
          <span class="absolute top-0 left-0 h-px w-0 bg-accent transition-[width] duration-700 ease-out group-hover:w-full" aria-hidden="true"></span>
          <p class="font-display text-sm text-muted">{s.num}</p>
          <h3 class="mt-6 text-xl md:text-[1.4rem] leading-snug">{s.title}</h3>
          <p class="mt-4 text-muted leading-relaxed">{s.desc}</p>
          <ul class="mt-6 space-y-2.5 text-sm">
            {s.items.map((it) => (
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-accent shrink-0" aria-hidden="true"></span>
                {it}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="mt-12 md:mt-16 rounded-2xl bg-surface border border-line p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-5 md:gap-10" data-reveal>
      <p class="font-display text-sm shrink-0">Siempre incluido</p>
      <ul class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-muted">
        {included.map((it) => (
          <li class="flex items-center gap-2.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {it}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
