---
import { getWhatsAppLink } from '../data/siteConfig';

const services = [
  {
    colSpan: "md:col-span-8",
    tag: "COMERCIOS & SHOWROOMS",
    title: "Catálogo online con pedidos directos a WhatsApp",
    desc: "Tus productos organizados las 24 horas con fotos optimizadas, variantes (talles, colores, modelos) y precios al día. El cliente elige lo que busca y con un clic te envía la orden armada a tu WhatsApp lista para coordinar el pago.",
    features: [
      "0% comisiones por venta",
      "Experiencia rápida pensada para celular",
      "Actualización ágil de precios y productos"
    ],
    waQuery: "Hola Hernán, me interesa desarrollar un catálogo online con pedidos a WhatsApp para mi negocio."
  },
  {
    colSpan: "md:col-span-4",
    tag: "VENTA DIRECTA & ANUNCIOS",
    title: "Landing pages para campañas",
    desc: "Páginas de una sola sección diseñadas para convencer en segundos. Pensadas para maximizar el retorno si hacés publicidad en Instagram, Facebook o Google Ads.",
    features: [
      "Estructura orientada a conversión",
      "Carga en menos de 1 segundo",
      "Sin elementos que distraigan la compra"
    ],
    waQuery: "Hola Hernán, quiero cotizar una landing page para pauta publicitaria."
  },
  {
    colSpan: "md:col-span-4",
    tag: "PROFESIONALES & EMPRESAS",
    title: "Sitios institucionales y corporativos",
    desc: "Presencia sobria y formal para estudios, consultorios, gestorías y pymes que necesitan proyectar seriedad y confianza ante clientes corporativos.",
    features: [
      "Diseño a medida de tu identidad",
      "Formularios de contacto directos",
      "Correos con dominio corporativo"
    ],
    waQuery: "Hola Hernán, necesito una web institucional para mi empresa o estudio."
  },
  {
    colSpan: "md:col-span-8",
    tag: "ZONA NORTE & GOOGLE MAPS",
    title: "SEO local: aparecé cuando busquen lo que vendés",
    desc: "Optimizamos el código con metadatos estructurados para Tortuguitas, Pilar, San Miguel y Zona Norte. Vinculamos tu página a tu ficha de Google Maps para atraer clientes en tu radio geográfico sin depender de pagar publicidad todo el tiempo.",
    features: [
      "Indexación técnica en Google Search Console",
      "Etiquetas georreferenciadas de Zona Norte",
      "Atracción de clientes locales cercanos"
    ],
    waQuery: "Hola Hernán, me gustaría optimizar mi web con SEO local para Zona Norte."
  }
];
---

<section id="servicios" class="py-16 md:py-24 border-t border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-4">
      <div>
        <div class="font-mono text-[11px] tracking-widest uppercase text-zinc-500 mb-2">
          02 // Servicios
        </div>
        <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tightest">
          Soluciones de desarrollo a medida
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-md font-normal leading-relaxed">
        Desarrollo enfocado en resolver problemas comerciales reales: velocidad de carga, experiencia en celulares y canales directos de compra.
      </p>
    </div>

    <!-- Bento Grid Services -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
      {services.map(s => {
        const waLink = getWhatsAppLink(s.waQuery);
        return (
          <div class={`bento-card p-6 sm:p-8 flex flex-col justify-between ${s.colSpan}`}>
            <div>
              <div class="font-mono text-[11px] text-zinc-500 tracking-wider uppercase mb-3">
                {s.tag}
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight mb-3">
                {s.title}
              </h3>
              <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-6">
                {s.desc}
              </p>
              
              <div class="space-y-2 mb-8">
                {s.features.map(f => (
                  <div class="flex items-center gap-2.5 text-xs text-zinc-300">
                    <span class="w-1 h-1 rounded-full bg-zinc-500"></span>
                    <span>{f}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-white/[0.06]">
              <a 
                href={waLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-xs font-medium text-zinc-300 hover:text-white transition-colors"
              >
                <span>Consultar por este servicio</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
