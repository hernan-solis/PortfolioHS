---
import { SITE_CONFIG } from '../data/siteConfig';

const businessTypes = [
  { id: "showroom", label: "Indumentaria / Showroom / Calzado" },
  { id: "tech", label: "Tecnología / Celulares / Accesorios" },
  { id: "gastronomia", label: "Gastronomía / Café / Delivery" },
  { id: "profesional", label: "Servicios / Gestoría / Estudio" },
  { id: "comercio", label: "Comercio minorista / mayorista" },
  { id: "otro", label: "Emprendimiento / Otro rubro" }
];

const projectTypes = [
  { id: "catalogo", label: "Catálogo online con cotizaciones directas (0% comisiones)" },
  { id: "landing", label: "Landing page de venta para publicidad en redes" },
  { id: "institucional", label: "Sitio web o plataforma institucional a medida" },
  { id: "rediseno", label: "Rediseñar o acelerar un sitio web existente" }
];

const zones = [
  "Tortuguitas",
  "Grand Bourg",
  "Pilar / Del Viso",
  "San Miguel / Muñiz",
  "Malvinas Argentinas",
  "Tigre / San Fernando",
  "San Isidro / Vte. López",
  "Otra zona / Remoto"
];
---

<section id="cotizador" class="section relative overflow-hidden py-20 md:py-28 border-t border-white/[0.06]">
  
  <!-- Subtle ambient glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-teal-500/[0.04] rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <div class="container-safe max-w-4xl mx-auto">
    
    <!-- Section Header -->
    <div data-reveal class="text-center max-w-2xl mx-auto mb-14 sm:mb-16">
      <div class="section-line w-16 mx-auto mb-6 rounded-full"></div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-white tracking-tight">
        Cotizador de proyecto
      </h2>
      <p class="mt-4 text-slate-400 text-sm sm:text-base leading-relaxed">
        Seleccioná lo que necesitás y armaremos una propuesta personalizada por correo.
      </p>
    </div>

    <!-- Interactive Card with MateLabs Style -->
    <div data-reveal class="card p-6 sm:p-10 relative">
      
      <!-- Step 1 -->
      <div class="mb-8">
        <label class="block text-xs font-mono uppercase tracking-wider text-teal-400 font-bold mb-3 flex items-center gap-2">
          <span>01.</span>
          <span class="text-slate-300">¿De qué rubro es tu negocio?</span>
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="business-options">
          {businessTypes.map((b, idx) => (
            <button 
              type="button"
              class={`quote-toggle text-left px-4 py-3 rounded-xl border text-xs transition-all ${
                idx === 0 
                  ? 'border-teal-500/80 bg-teal-500/15 text-white font-semibold shadow-sm' 
                  : 'border-white/[0.08] bg-slate-900/60 text-slate-300 hover:border-slate-700'
              }`}
              data-group="business"
              data-value={b.label}
            >
              {b.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Step 2 -->
      <div class="mb-8">
        <label class="block text-xs font-mono uppercase tracking-wider text-teal-400 font-bold mb-3 flex items-center gap-2">
          <span>02.</span>
          <span class="text-slate-300">¿Qué tipo de desarrollo estás buscando?</span>
        </label>
        <div class="grid grid-cols-1 gap-2.5" id="project-options">
          {projectTypes.map((p, idx) => (
            <button 
              type="button"
              class={`quote-toggle text-left px-4 py-3 rounded-xl border text-xs transition-all ${
                idx === 0 
                  ? 'border-teal-500/80 bg-teal-500/15 text-white font-semibold shadow-sm' 
                  : 'border-white/[0.08] bg-slate-900/60 text-slate-300 hover:border-slate-700'
              }`}
              data-group="project"
              data-value={p.label}
            >
              {p.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Step 3 -->
      <div class="mb-10">
        <label class="block text-xs font-mono uppercase tracking-wider text-teal-400 font-bold mb-3 flex items-center gap-2">
          <span>03.</span>
          <span class="text-slate-300">¿En qué localidad te encontrás?</span>
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="zone-options">
          {zones.map((z, idx) => (
            <button 
              type="button"
              class={`quote-toggle text-center px-3 py-2.5 rounded-xl border text-xs transition-all ${
                idx === 0 
                  ? 'border-teal-500/80 bg-teal-500/15 text-white font-semibold shadow-sm' 
                  : 'border-white/[0.08] bg-slate-900/60 text-slate-300 hover:border-slate-700'
              }`}
              data-group="zone"
              data-value={z}
            >
              {z}
            </button>
          ))}
        </div>
      </div>

      <!-- Summary & Proposal Action Container -->
      <div class="rounded-2xl bg-slate-950/90 p-5 sm:p-7 border border-white/10 shadow-2xl space-y-4">
        
        <!-- Header -->
        <div class="flex items-center justify-between pb-3 border-b border-white/[0.08]">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full overflow-hidden border border-teal-500/40 bg-slate-900 flex-shrink-0">
              <img 
                src="/assets/img/imgFotoPerfilEditado_websize.jpg" 
                alt="Hernán Solis" 
                class="w-full h-full object-cover"
              />
            </div>
            <div>
              <div class="text-xs font-bold text-white flex items-center gap-1.5">
                <span>Hernán Solis</span>
                <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
              </div>
              <div class="text-[10px] text-slate-400 font-mono">Respuesta por correo en menos de 24 hs</div>
            </div>
          </div>
          <span class="text-[11px] font-mono text-teal-400 bg-teal-500/10 px-2.5 py-1 rounded-full border border-teal-500/20 hidden sm:inline-block">
            Cotización estimada
          </span>
        </div>

        <!-- Generated Message Preview -->
        <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.08]">
          <p class="text-[11px] font-mono text-slate-400 mb-1.5">Resumen de tu consulta:</p>
          <p id="quote-preview-text" class="text-xs sm:text-sm text-slate-200 leading-relaxed font-medium">
            Hola Hernán, tengo un negocio de Indumentaria / Showroom / Calzado en Tortuguitas y me interesa desarrollar un Catálogo online con cotizaciones directas (0% comisiones). ¿Podrías enviarme una propuesta técnica y presupuesto estimado?
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
          <button 
            id="btn-apply-quote"
            type="button"
            class="btn btn-primary btn-lg w-full sm:w-auto group"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <span>Enviar esta cotización por formulario</span>
          </button>

          <a 
            id="btn-mailto-quote"
            href={`mailto:${SITE_CONFIG.email}`}
            class="btn btn-secondary btn-lg w-full sm:w-auto"
          >
            <span>Abrir en mi app de correo</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

<script define:vars={{ emailAddress: SITE_CONFIG.email }}>
  let selBusiness = "Indumentaria / Showroom / Calzado";
  let selProject = "Catálogo online con cotizaciones directas (0% comisiones)";
  let selZone = "Tortuguitas";

  const preview = document.getElementById('quote-preview-text');
  const applyBtn = document.getElementById('btn-apply-quote');
  const mailtoBtn = document.getElementById('btn-mailto-quote');

  function getMessageText() {
    return `Hola Hernán, tengo un negocio de ${selBusiness} en ${selZone} y me interesa desarrollar un ${selProject}. ¿Podrías enviarme una propuesta técnica y presupuesto estimado?`;
  }

  function update() {
    const text = getMessageText();
    if (preview) {
      preview.textContent = text;
    }
    if (mailtoBtn) {
      const subject = encodeURIComponent(`Consulta de proyecto web - ${selBusiness} (${selZone})`);
      const body = encodeURIComponent(text);
      mailtoBtn.setAttribute('href', `mailto:${emailAddress}?subject=${subject}&body=${body}`);
    }
  }

  document.querySelectorAll('.quote-toggle').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const group = target.getAttribute('data-group');
      const val = target.getAttribute('data-value');

      document.querySelectorAll(`.quote-toggle[data-group="${group}"]`).forEach(b => {
        b.classList.remove('border-teal-500/80', 'bg-teal-500/15', 'text-white', 'font-semibold', 'shadow-sm');
        b.classList.add('border-white/[0.08]', 'bg-slate-900/60', 'text-slate-300');
      });

      target.classList.remove('border-white/[0.08]', 'bg-slate-900/60', 'text-slate-300');
      target.classList.add('border-teal-500/80', 'bg-teal-500/15', 'text-white', 'font-semibold', 'shadow-sm');

      if (group === 'business') selBusiness = val;
      if (group === 'project') selProject = val;
      if (group === 'zone') selZone = val;

      update();
    });
  });

  if (applyBtn) {
    applyBtn.addEventListener('click', () => {
      const messageField = document.getElementById('contact-message') || document.getElementById('mensaje');
      if (messageField) {
        messageField.value = getMessageText();
      }
      const contactSection = document.getElementById('contacto');
      if (contactSection) {
        contactSection.scrollIntoView({ behavior: 'smooth' });
        setTimeout(() => {
          const nameInput = document.getElementById('contact-name') || document.getElementById('nombre');
          nameInput?.focus();
        }, 500);
      }
    });
  }

  update();
</script>
