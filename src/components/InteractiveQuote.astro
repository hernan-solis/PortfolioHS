---
import { SITE_CONFIG } from '../data/siteConfig';

const businessTypes = [
  { id: "showroom", label: "Indumentaria / Showroom / Calzado" },
  { id: "tech", label: "Tecnología / Celulares / Accesorios" },
  { id: "gastronomia", label: "Gastronomía / Café / Delivery" },
  { id: "profesional", label: "Servicios / Gestoría / Estudio" },
  { id: "comercio", label: "Comercio minorista / mayorista" },
  { id: "otro", label: "Emprendimiento / Otro rubro" }
];

const projectTypes = [
  { id: "catalogo", label: "Catálogo online con pedidos a WhatsApp (0% comisiones)" },
  { id: "landing", label: "Landing page de venta para publicidad en redes" },
  { id: "institucional", label: "Sitio web institucional completo con formulario" },
  { id: "rediseno", label: "Rediseñar o acelerar un sitio web existente" }
];

const zones = [
  "Tortuguitas",
  "Grand Bourg",
  "Pilar / Del Viso",
  "San Miguel / Muñiz",
  "Malvinas Argentinas",
  "Tigre / San Fernando",
  "San Isidro / Vte. López",
  "Otra zona / Remoto"
];
---

<section id="cotizador" class="py-16 md:py-24 border-t border-white/[0.06]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-12 sm:mb-16">
      <div class="font-mono text-[11px] tracking-widest uppercase text-zinc-500 mb-2">
        04 // Asistente de presupuesto
      </div>
      <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tightest mb-3">
        Cotizá tu proyecto en tres pasos
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-lg mx-auto leading-relaxed">
        Elegí las características de tu negocio y generá una consulta directa para recibir un presupuesto estimado por WhatsApp.
      </p>
    </div>

    <!-- Interactive Card -->
    <div class="bento-card p-6 sm:p-10">
      
      <!-- Step 1 -->
      <div class="mb-8">
        <label class="block text-xs font-mono uppercase tracking-wider text-zinc-400 mb-3">
          1. Rubro o tipo de actividad
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="business-options">
          {businessTypes.map((b, idx) => (
            <button 
              type="button"
              class={`quote-toggle text-left px-3.5 py-3 rounded-lg border text-xs transition-all ${
                idx === 0 
                  ? 'border-white bg-white text-zinc-950 font-semibold active-choice' 
                  : 'border-white/[0.08] bg-zinc-900/60 text-zinc-300 hover:border-zinc-700'
              }`}
              data-group="business"
              data-value={b.label}
            >
              {b.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Step 2 -->
      <div class="mb-8">
        <label class="block text-xs font-mono uppercase tracking-wider text-zinc-400 mb-3">
          2. Tipo de sitio web que necesitás
        </label>
        <div class="grid grid-cols-1 gap-2" id="project-options">
          {projectTypes.map((p, idx) => (
            <button 
              type="button"
              class={`quote-toggle text-left px-3.5 py-3 rounded-lg border text-xs transition-all ${
                idx === 0 
                  ? 'border-white bg-white text-zinc-950 font-semibold active-choice' 
                  : 'border-white/[0.08] bg-zinc-900/60 text-zinc-300 hover:border-zinc-700'
              }`}
              data-group="project"
              data-value={p.label}
            >
              {p.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Step 3 -->
      <div class="mb-10">
        <label class="block text-xs font-mono uppercase tracking-wider text-zinc-400 mb-3">
          3. Localidad en Zona Norte
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="zone-options">
          {zones.map((z, idx) => (
            <button 
              type="button"
              class={`quote-toggle text-center px-3 py-2.5 rounded-lg border text-xs transition-all ${
                idx === 0 
                  ? 'border-white bg-white text-zinc-950 font-semibold active-choice' 
                  : 'border-white/[0.08] bg-zinc-900/60 text-zinc-300 hover:border-zinc-700'
              }`}
              data-group="zone"
              data-value={z}
            >
              {z}
            </button>
          ))}
        </div>
      </div>

      <!-- Live Preview & Button -->
      <div class="p-5 rounded-xl bg-zinc-900/90 border border-white/[0.06] text-center">
        <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 mb-2">
          Mensaje que se enviará:
        </div>
        <p id="quote-preview-text" class="text-xs text-zinc-200 font-mono italic mb-6 max-w-xl mx-auto p-3 bg-zinc-950 rounded border border-white/[0.05]">
          "Hola Hernán, tengo un negocio de Indumentaria / Showroom / Calzado en Tortuguitas y me interesa desarrollar un Catálogo online con pedidos a WhatsApp (0% comisiones). ¿Podrías darme un presupuesto estimado?"
        </p>

        <button 
          id="btn-send-quote"
          type="button"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl bg-zinc-100 hover:bg-white text-zinc-950 font-semibold text-xs sm:text-sm tracking-tight transition-all duration-200"
        >
          <svg class="w-4 h-4 fill-current text-whatsapp" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>Consultar presupuesto por WhatsApp</span>
        </button>
      </div>

    </div>

  </div>
</section>

<script define:vars={{ waNumber: SITE_CONFIG.whatsappNumber }}>
  let selBusiness = "Indumentaria / Showroom / Calzado";
  let selProject = "Catálogo online con pedidos a WhatsApp (0% comisiones)";
  let selZone = "Tortuguitas";

  const preview = document.getElementById('quote-preview-text');
  const sendBtn = document.getElementById('btn-send-quote');

  function update() {
    const text = `Hola Hernán, tengo un negocio de ${selBusiness} en ${selZone} y me interesa desarrollar un ${selProject}. ¿Podrías darme un presupuesto estimado?`;
    if (preview) {
      preview.textContent = `"${text}"`;
    }
  }

  document.querySelectorAll('.quote-toggle').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const group = target.getAttribute('data-group');
      const val = target.getAttribute('data-value');

      document.querySelectorAll(`.quote-toggle[data-group="${group}"]`).forEach(b => {
        b.classList.remove('border-white', 'bg-white', 'text-zinc-950', 'font-semibold', 'active-choice');
        b.classList.add('border-white/[0.08]', 'bg-zinc-900/60', 'text-zinc-300');
      });

      target.classList.remove('border-white/[0.08]', 'bg-zinc-900/60', 'text-zinc-300');
      target.classList.add('border-white', 'bg-white', 'text-zinc-950', 'font-semibold', 'active-choice');

      if (group === 'business') selBusiness = val;
      if (group === 'project') selProject = val;
      if (group === 'zone') selZone = val;

      update();
    });
  });

  if (sendBtn) {
    sendBtn.addEventListener('click', () => {
      const msg = `Hola Hernán, estuve en el cotizador de tu web. Tengo un negocio de ${selBusiness} en ${selZone} y me gustaría consultar por ${selProject}. ¿Podrías darme un presupuesto?`;
      const url = `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
      window.open(url, '_blank');
    });
  }
</script>
