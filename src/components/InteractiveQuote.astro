---
import { SITE_CONFIG } from '../data/siteConfig';

const businessTypes = [
  { id: "tienda-showroom", label: "👗 Showroom / Indumentaria / Calzado" },
  { id: "tecnologia-accesorios", label: "📱 Tecnología / Celulares / Accesorios" },
  { id: "gastronomia-comida", label: "🍔 Gastronomía / Restaurante / Delivery" },
  { id: "profesional-servicios", label: "🏛️ Servicios Profesionales / Gestoría / Salud" },
  { id: "comercio-general", label: "🛍️ Comercio Local / Venta Mayorista o Minorista" },
  { id: "otro", label: "✨ Emprendimiento / Otro Rubro" }
];

const webTypes = [
  { id: "catalogo-wa", label: "Catálogo Online con Pedidos a WhatsApp (0% comisión)" },
  { id: "landing-page", label: "Landing Page de Alta Conversión (Venta Rápida)" },
  { id: "web-institucional", label: "Sitio Web Institucional Completo" },
  { id: "rediseno-speed", label: "Rediseñar o Acelerar una Web Existente" }
];

const zones = [
  "Tortuguitas",
  "Grand Bourg",
  "Pilar / Del Viso",
  "San Miguel / Muñiz",
  "Malvinas Argentinas",
  "Tigre / San Fernando",
  "San Isidro / Vte. López",
  "Otra Zona / Remoto"
];
---

<section id="cotizador" class="py-20 md:py-28 bg-dark-900/50 relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-primary/10 border border-brand-primary/30 text-xs sm:text-sm text-brand-primary font-semibold mb-4">
        <span>⚡ Cotizador Rápido en 3 Clics</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        Calculá el proyecto para <br class="hidden sm:inline" />
        <span class="text-gradient-emerald">tu negocio en segundos</span>
      </h2>
      <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto">
        Seleccioná lo que necesitás y el asistente armará un mensaje personalizado para darte un presupuesto exacto por WhatsApp.
      </p>
    </div>

    <!-- Interactive Card -->
    <div class="glass-card rounded-3xl p-6 sm:p-10 border border-slate-800 shadow-glow relative">
      
      <!-- Step 1: Business Type -->
      <div class="mb-8">
        <label class="block text-sm font-bold text-white mb-3">
          1. ¿De qué rubro es tu negocio o comercio?
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="business-options">
          {businessTypes.map((item, idx) => (
            <button 
              type="button"
              class={`quote-option-btn text-left p-3.5 rounded-xl border text-xs sm:text-sm font-medium transition-all duration-200 ${
                idx === 0 
                  ? 'border-brand-primary bg-brand-primary/15 text-white active-option' 
                  : 'border-slate-800 bg-dark-900/60 text-slate-300 hover:border-slate-700'
              }`}
              data-group="business"
              data-value={item.label}
            >
              {item.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Step 2: Web Type -->
      <div class="mb-8">
        <label class="block text-sm font-bold text-white mb-3">
          2. ¿Qué tipo de página web te gustaría tener?
        </label>
        <div class="grid grid-cols-1 gap-2.5" id="web-options">
          {webTypes.map((item, idx) => (
            <button 
              type="button"
              class={`quote-option-btn text-left p-3.5 rounded-xl border text-xs sm:text-sm font-medium transition-all duration-200 ${
                idx === 0 
                  ? 'border-brand-primary bg-brand-primary/15 text-white active-option' 
                  : 'border-slate-800 bg-dark-900/60 text-slate-300 hover:border-slate-700'
              }`}
              data-group="web"
              data-value={item.label}
            >
              {item.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Step 3: Zone -->
      <div class="mb-10">
        <label class="block text-sm font-bold text-white mb-3">
          3. ¿En qué localidad te encontrás?
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="zone-options">
          {zones.map((zone, idx) => (
            <button 
              type="button"
              class={`quote-option-btn text-center p-2.5 rounded-xl border text-xs font-medium transition-all duration-200 ${
                idx === 0 
                  ? 'border-brand-primary bg-brand-primary/15 text-white active-option' 
                  : 'border-slate-800 bg-dark-900/60 text-slate-300 hover:border-slate-700'
              }`}
              data-group="zone"
              data-value={zone}
            >
              📍 {zone}
            </button>
          ))}
        </div>
      </div>

      <!-- Preview & Submit Button -->
      <div class="p-4 sm:p-6 rounded-2xl bg-dark-950/80 border border-slate-800 text-center">
        <div class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-2">
          Mensaje que se enviará a Hernán por WhatsApp:
        </div>
        <p id="quote-preview" class="text-xs sm:text-sm text-emerald-300 font-medium italic mb-6 max-w-lg mx-auto bg-dark-900/90 p-3 rounded-xl border border-slate-800/80">
          "¡Hola Hernán! Tengo un negocio de Showroom / Indumentaria en Tortuguitas y me interesa desarrollar un Catálogo Online con Pedidos a WhatsApp. ¿Podrías pasarme un presupuesto estimado?"
        </p>

        <button 
          id="send-quote-wa-btn"
          type="button"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-whatsapp hover:bg-whatsapp-hover text-white font-extrabold text-base shadow-whatsapp transition-all duration-300 transform hover:scale-[1.02] active:scale-[0.98]"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>Pedir Presupuesto por WhatsApp</span>
        </button>
      </div>

    </div>

  </div>
</section>

<script define:vars={{ waNumber: SITE_CONFIG.whatsappNumber }}>
  let selectedBusiness = "Showroom / Indumentaria / Calzado";
  let selectedWeb = "Catálogo Online con Pedidos a WhatsApp (0% comisión)";
  let selectedZone = "Tortuguitas";

  const previewEl = document.getElementById('quote-preview');
  const sendBtn = document.getElementById('send-quote-wa-btn');

  function updatePreview() {
    const text = `¡Hola Hernán! Tengo un negocio de ${selectedBusiness} en ${selectedZone} y me interesa desarrollar un ${selectedWeb}. ¿Podrías pasarme un presupuesto estimado?`;
    if (previewEl) {
      previewEl.textContent = `"${text}"`;
    }
  }

  document.querySelectorAll('.quote-option-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const group = target.getAttribute('data-group');
      const val = target.getAttribute('data-value');

      // Unselect siblings
      document.querySelectorAll(`.quote-option-btn[data-group="${group}"]`).forEach(b => {
        b.classList.remove('border-brand-primary', 'bg-brand-primary/15', 'text-white', 'active-option');
        b.classList.add('border-slate-800', 'bg-dark-900/60', 'text-slate-300');
      });

      // Select clicked
      target.classList.remove('border-slate-800', 'bg-dark-900/60', 'text-slate-300');
      target.classList.add('border-brand-primary', 'bg-brand-primary/15', 'text-white', 'active-option');

      if (group === 'business') selectedBusiness = val.replace(/^[^\w\s]+/, '').trim();
      if (group === 'web') selectedWeb = val;
      if (group === 'zone') selectedZone = val;

      updatePreview();
    });
  });

  if (sendBtn) {
    sendBtn.addEventListener('click', () => {
      const message = `¡Hola Hernán! Estuve en el cotizador de tu web. Tengo un negocio de ${selectedBusiness} en ${selectedZone} y me gustaría consultar por ${selectedWeb}. ¿Podrías darme un presupuesto?`;
      const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;
      window.open(waUrl, '_blank');
    });
  }
</script>
