---
import { SITE_CONFIG, getWhatsAppLink } from '../data/siteConfig';

const heroWa = getWhatsAppLink("Hola Hernán, vi tu web y me gustaría hablar sobre el desarrollo de una página para mi negocio.");
---

<section class="pt-8 pb-14 md:pt-14 md:pb-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
      
      <!-- Primary Main Hero Tile (8 cols) -->
      <div class="bento-card p-7 sm:p-10 md:col-span-8 flex flex-col justify-between relative overflow-hidden">
        <div class="space-y-6">
          
          <!-- Micro Label -->
          <div class="flex items-center gap-2">
            <span class="status-dot"></span>
            <span class="font-mono text-[11px] tracking-wider uppercase text-zinc-400">
              Desarrollador Web • Tortuguitas & Zona Norte
            </span>
          </div>

          <!-- Main Title -->
          <h1 class="text-3xl sm:text-5xl lg:text-[54px] font-bold text-white tracking-tightest leading-[1.08]">
            Sitios web rápidos y tiendas con catálogo pensados para vender.
          </h1>

          <!-- Body Copy -->
          <p class="text-sm sm:text-base text-zinc-400 font-normal leading-relaxed max-w-xl">
            Creo páginas web a medida para comercios, marcas y profesionales locales. Carga instantánea en celulares, integración directa con WhatsApp y posicionamiento en Google, sin plantillas pesadas ni comisiones por venta.
          </p>

        </div>

        <!-- Action CTAs -->
        <div class="pt-8 mt-6 border-t border-white/[0.06] flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a 
            href={heroWa}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-zinc-100 hover:bg-white text-zinc-950 font-semibold text-xs sm:text-sm tracking-tight transition-all duration-200"
          >
            <svg class="w-4 h-4 fill-current text-whatsapp" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Consultar por WhatsApp</span>
          </a>

          <a 
            href="#proyectos"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-300 hover:text-white border border-white/10 font-medium text-xs sm:text-sm transition-all duration-200"
          >
            <span>Ver trabajos recientes</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
            </svg>
          </a>
        </div>

      </div>

      <!-- Identity & Location Tile (4 cols) -->
      <div class="bento-card p-6 sm:p-7 md:col-span-4 flex flex-col justify-between">
        
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-full overflow-hidden border border-white/10 bg-zinc-900 flex-shrink-0">
              <img 
                src="/assets/img/imgFotoPerfilEditado_websize.jpg" 
                alt="Hernán Solís" 
                class="w-full h-full object-cover"
                loading="eager"
                onerror="this.src='/assets/img/imgFotoPerfil.jpeg'"
              />
            </div>
            <div>
              <h2 class="text-base font-semibold text-white tracking-tight">Hernán Solís</h2>
              <p class="text-xs text-zinc-400 font-mono">Desarrollador Web</p>
              <p class="text-[11px] text-zinc-500 font-mono mt-0.5">Tortuguitas, Buenos Aires</p>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-zinc-900/60 border border-white/[0.05] space-y-2">
            <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-wider">Formación & Enfoque</div>
            <p class="text-xs text-zinc-300 leading-relaxed">
              Estudiante de Tecnicatura en Programación en la <strong>UTN</strong>. Desarrollo enfocado en rendimiento, código limpio y trato directo.
            </p>
          </div>
        </div>

        <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs">
          <span class="text-zinc-500 font-mono">Zona de cobertura:</span>
          <span class="text-zinc-300 font-medium">Zona Norte & Remoto</span>
        </div>

      </div>

      <!-- Metric Tile 1: Architecture & Speed (4 cols) -->
      <div class="bento-card p-6 md:col-span-4 flex flex-col justify-between">
        <div class="flex items-center justify-between text-zinc-500 font-mono text-xs mb-3">
          <span>RENDIMIENTO MÓVIL</span>
          <span class="text-emerald-400 font-bold">100/100</span>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-mono font-bold text-white tracking-tight mb-1">&lt;0.5s</div>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Velocidad de carga real en redes 4G y 5G. Los usuarios no esperan ni abandonan tu sitio.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-white/[0.06] text-[11px] font-mono text-zinc-500">
          Stack: Astro • Tailwind • Cloudflare
        </div>
      </div>

      <!-- Metric Tile 2: Zero Commissions (4 cols) -->
      <div class="bento-card p-6 md:col-span-4 flex flex-col justify-between">
        <div class="flex items-center justify-between text-zinc-500 font-mono text-xs mb-3">
          <span>MODELO INDEPENDIENTE</span>
          <span class="text-zinc-400">100% tuyo</span>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-mono font-bold text-white tracking-tight mb-1">0%</div>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Sin comisiones por venta ni cargos mensuales abusivos. Las ganancias de tu negocio son tuyas.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-white/[0.06] text-[11px] font-mono text-zinc-500">
          Sin intermediarios de pago forzados
        </div>
      </div>

      <!-- Metric Tile 3: WhatsApp Direct Conversion (4 cols) -->
      <div class="bento-card p-6 md:col-span-4 flex flex-col justify-between">
        <div class="flex items-center justify-between text-zinc-500 font-mono text-xs mb-3">
          <span>CANAL DE VENTA</span>
          <span class="text-emerald-400 font-mono">WhatsApp</span>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-mono font-bold text-white tracking-tight mb-1">1 Clic</div>
          <p class="text-xs text-zinc-400 leading-relaxed">
            El cliente arma su pedido en la web y te llega estructurado directo a tu chat para cerrar la venta.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-white/[0.06] text-[11px] font-mono text-zinc-500">
          Pedidos claros con nombre, talle y precio
        </div>
      </div>

    </div>

  </div>
</section>
