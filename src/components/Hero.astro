---
import { SITE_CONFIG } from '../data/siteConfig';
---

<section class="relative pt-24 pb-16 md:pt-32 md:pb-24 overflow-hidden">
  
  <!-- Atmospheric background glows -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] rounded-full" style="background: radial-gradient(ellipse, rgba(20,184,166,0.12) 0%, rgba(20,184,166,0.03) 40%, transparent 70%);"></div>
    <div class="absolute top-[20%] right-[10%] w-[450px] h-[450px] rounded-full" style="background: radial-gradient(circle, rgba(34,211,238,0.08) 0%, transparent 60%);"></div>
    <div class="absolute top-[35%] left-[5%] w-[400px] h-[400px] rounded-full" style="background: radial-gradient(circle, rgba(139,92,246,0.06) 0%, transparent 60%);"></div>
  </div>

  <div class="container-safe relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Copy & Value Proposition (7 cols) -->
      <div data-reveal class="lg:col-span-7 flex flex-col items-start text-left space-y-6">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border text-xs font-semibold" style="background: linear-gradient(135deg, rgba(20,184,166,0.1), rgba(139,92,246,0.08)); border-color: rgba(20,184,166,0.25); color: #2dd4bf;">
          <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
          <span>Desarrollo Web & Software — Tortuguitas, Zona Norte</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.12]">
          Construyo <br />
          <span class="text-transparent bg-clip-text gradient-shimmer" style="background-image: linear-gradient(90deg, #14b8a6, #22d3ee, #8b5cf6, #14b8a6);">
            software y sitios web
          </span> <br />
          que funcionan en producción.
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-400 max-w-xl leading-relaxed font-normal">
          Diseño y desarrollo web a medida para comercios, marcas y profesionales. Plataformas rápidas, tiendas con catálogo digital y soluciones tecnológicas que impulsan negocios reales, sin intermediarios ni comisiones.
        </p>

        <!-- CTAs -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 w-full sm:w-auto">
          <a 
            href="#proyectos"
            class="btn btn-primary btn-lg group"
          >
            <span>Ver proyectos</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>

          <a 
            href="#contacto"
            class="btn btn-secondary btn-lg group"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2 text-teal-400 transition-transform duration-200 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <span>Hablemos por correo</span>
          </a>
        </div>

        <!-- Metric Badges -->
        <div class="grid grid-cols-3 gap-3 pt-4 w-full max-w-lg">
          <div class="card p-3.5 text-center">
            <div class="text-base sm:text-lg font-bold text-white font-mono">&lt;0.5s</div>
            <div class="text-[11px] text-slate-400 font-mono mt-0.5">Carga móvil</div>
          </div>
          <div class="card p-3.5 text-center">
            <div class="text-base sm:text-lg font-bold text-teal-400 font-mono">0%</div>
            <div class="text-[11px] text-slate-400 font-mono mt-0.5">Comisiones</div>
          </div>
          <div class="card p-3.5 text-center">
            <div class="text-base sm:text-lg font-bold text-cyan-400 font-mono">100%</div>
            <div class="text-[11px] text-slate-400 font-mono mt-0.5">A medida</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Mockup (5 cols) -->
      <div data-reveal class="lg:col-span-5 flex justify-center relative">
        
        <!-- Glow behind device -->
        <div class="absolute inset-0 bg-gradient-to-tr from-teal-500/20 via-cyan-500/15 to-violet-500/20 rounded-[50px] blur-2xl transform -rotate-3 scale-95 pointer-events-none"></div>

        <!-- Realistic CSS Frame -->
        <div class="iphone-frame relative z-10 transform sm:rotate-1 hover:rotate-0 transition-transform duration-500">
          
          <div class="iphone-screen">
            <!-- Dynamic Island -->
            <div class="iphone-island flex items-center justify-between px-3">
              <span class="w-2.5 h-2.5 rounded-full bg-zinc-900 border border-zinc-800"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse"></span>
            </div>

            <!-- Screen Header (Mockup of Tu iPhone Zona Norte) -->
            <div class="pt-10 pb-4 px-4 bg-slate-950 border-b border-white/[0.08] flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-md bg-slate-800 flex items-center justify-center text-[10px] font-bold text-white">
                  📱
                </div>
                <div class="text-[11px] font-bold text-white tracking-tight">Tu iPhone Zona Norte</div>
              </div>
              <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-teal-500/20 text-teal-300 border border-teal-500/30">
                En stock
              </span>
            </div>

            <!-- Mockup Content inside the Phone -->
            <div class="p-4 space-y-3.5 bg-slate-900/60">
              
              <!-- Featured Card inside phone -->
              <div class="p-3.5 rounded-2xl bg-slate-950 border border-white/10 shadow-md space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-bold text-white">iPhone 15 Pro Max</span>
                  <span class="text-[10px] font-mono font-semibold text-teal-400">Cotizador en vivo</span>
                </div>

                <div class="w-full aspect-[16/9] bg-slate-900 rounded-xl overflow-hidden flex items-center justify-center p-2 border border-white/[0.05]">
                  <img 
                    src="/assets/projects/tuiphone-logo.jpg" 
                    alt="Logo Tu iPhone Zona Norte" 
                    class="h-14 w-auto object-contain"
                  />
                </div>

                <!-- Battery Health Indicator -->
                <div class="space-y-1">
                  <div class="flex justify-between text-[9px] font-mono text-slate-400">
                    <span>Salud de batería</span>
                    <span class="text-teal-400 font-bold">100% Garantizada</span>
                  </div>
                  <div class="w-full h-1.5 rounded-full bg-slate-800 overflow-hidden">
                    <div class="w-full h-full bg-teal-400 rounded-full"></div>
                  </div>
                </div>

                <!-- Action button inside mockup -->
                <a 
                  href="https://tuiphonezonanorte.com.ar"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full flex items-center justify-center gap-1.5 py-2 rounded-xl bg-teal-600 text-white text-[11px] font-bold shadow-md hover:bg-teal-500 transition-colors"
                >
                  <span>Explorar catálogo en vivo ↗</span>
                </a>
              </div>

              <!-- Mini Feature Row inside phone -->
              <div class="grid grid-cols-2 gap-2 text-center text-[9px] font-mono">
                <div class="p-2 rounded-xl bg-slate-950 border border-white/[0.05] text-slate-300">
                  Plan Canje Activo
                </div>
                <div class="p-2 rounded-xl bg-slate-950 border border-white/[0.05] text-slate-300">
                  Garantía Escrita
                </div>
              </div>

            </div>

            <!-- Home indicator bar -->
            <div class="py-2 flex justify-center bg-slate-950">
              <div class="w-24 h-1 bg-slate-600 rounded-full"></div>
            </div>

          </div>
        </div>

        <!-- Floating Glass Badge: Instagram +18K -->
        <div class="hidden sm:flex glass-badge absolute -top-4 -right-4 z-20 px-3.5 py-2 rounded-xl items-center gap-2 text-xs font-mono text-white shadow-xl">
          <span class="w-2 h-2 rounded-full bg-teal-400"></span>
          <span>+18K seguidores en Instagram</span>
        </div>

        <!-- Floating Glass Badge: Real Time Quote -->
        <div class="hidden sm:flex glass-badge absolute -bottom-4 -left-4 z-20 px-3.5 py-2 rounded-xl items-center gap-2 text-xs font-mono text-slate-200 shadow-xl">
          <span class="text-teal-400">✓</span>
          <span>Cotizador en tiempo real</span>
        </div>

      </div>

    </div>
  </div>
</section>
