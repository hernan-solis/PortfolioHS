---
import { getWhatsAppLink } from '../data/siteConfig';

const heroWaLink = getWhatsAppLink("¡Hola Hernán! Quiero mejorar la presencia online de mi negocio y cotizar una página web.");
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  
  <!-- Subtle background glow shapes -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 sm:w-96 sm:h-96 bg-brand-primary/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 right-10 w-60 h-60 bg-brand-cyan/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      
      <!-- Location and Status Badge -->
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full glass-card border border-emerald-500/30 text-xs sm:text-sm text-emerald-300 font-semibold mb-6 shadow-glow">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>📍 Desarrollador Web en Tortuguitas & Zona Norte (GBA)</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15] sm:leading-[1.12] mb-6">
        Páginas web y tiendas online que <br class="hidden sm:inline" />
        <span class="text-gradient-emerald">multiplican las ventas</span> de tu negocio.
      </h1>

      <!-- Value Proposition Subtitle -->
      <p class="text-base sm:text-xl text-slate-300 font-normal leading-relaxed max-w-2xl mb-8 sm:mb-10">
        Ayudo a comercios, marcas y profesionales locales a destacarse con sitios web <strong class="text-white font-semibold">ultra rápidos en celulares</strong>, diseño moderno y <strong class="text-white font-semibold">pedidos directos a WhatsApp</strong>. Sin mensualidades excesivas ni comisiones.
      </p>

      <!-- Action Buttons (Mobile-first stacked on small, side-by-side on tablet/desktop) -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-12 sm:mb-14">
        
        <!-- Primary WhatsApp CTA -->
        <a 
          href={heroWaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-brand-primary to-brand-cyan hover:from-emerald-400 hover:to-cyan-400 text-dark-950 font-extrabold text-base shadow-glow hover:shadow-glow-cyan transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>Escribime por WhatsApp</span>
        </a>

        <!-- Secondary Projects CTA -->
        <a 
          href="#trabajos"
          class="flex items-center justify-center gap-2 px-8 py-4 rounded-2xl glass-card hover:bg-slate-800/80 border border-slate-700/80 text-slate-200 font-bold text-base hover:text-white transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>Ver Proyectos Reales</span>
          <svg class="w-4 h-4 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

      </div>

      <!-- Value Pillars / Key Highlights (Mobile Grid) -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 w-full text-left">
        
        <div class="glass-card p-3.5 sm:p-4 rounded-xl border border-slate-800 flex items-start gap-3">
          <div class="p-2 rounded-lg bg-emerald-500/10 text-emerald-400 text-lg flex-shrink-0">
            ⚡
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-white">Carga Instantánea</h4>
            <p class="text-[11px] sm:text-xs text-slate-400">Menos de 1s en celulares 4G/5G</p>
          </div>
        </div>

        <div class="glass-card p-3.5 sm:p-4 rounded-xl border border-slate-800 flex items-start gap-3">
          <div class="p-2 rounded-lg bg-cyan-500/10 text-cyan-400 text-lg flex-shrink-0">
            💬
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-white">Ventas por WhatsApp</h4>
            <p class="text-[11px] sm:text-xs text-slate-400">Tus clientes piden con 1 clic</p>
          </div>
        </div>

        <div class="glass-card p-3.5 sm:p-4 rounded-xl border border-slate-800 flex items-start gap-3">
          <div class="p-2 rounded-lg bg-blue-500/10 text-blue-400 text-lg flex-shrink-0">
            🔍
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-white">SEO en Zona Norte</h4>
            <p class="text-[11px] sm:text-xs text-slate-400">Aparecé en Google y Maps</p>
          </div>
        </div>

        <div class="glass-card p-3.5 sm:p-4 rounded-xl border border-slate-800 flex items-start gap-3">
          <div class="p-2 rounded-lg bg-purple-500/10 text-purple-400 text-lg flex-shrink-0">
            🤝
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-white">Trato Directo</h4>
            <p class="text-[11px] sm:text-xs text-slate-400">Hablás con el programador</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
