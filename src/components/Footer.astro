---
import { SITE_CONFIG, getWhatsAppLink } from '../data/siteConfig';

const footerWaLink = getWhatsAppLink("¡Hola Hernán! Te contacto desde el pie de página de tu web.");
---

<footer class="bg-dark-950 border-t border-slate-800/80 pt-16 pb-12 text-slate-400 text-xs sm:text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-12 pb-12 border-b border-slate-800/80">
      
      <!-- Brand Column (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-primary to-brand-cyan p-0.5 shadow-glow">
            <div class="w-full h-full bg-dark-950 rounded-[10px] flex items-center justify-center font-extrabold text-white text-base">
              HS
            </div>
          </div>
          <div>
            <span class="font-extrabold text-white text-base block leading-tight">Hernán Solís</span>
            <span class="text-xs text-brand-primary font-medium">Programador & Desarrollador Web</span>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm">
          Desarrollo sitios web modernos, tiendas online y catálogos interactivos con conexión directa a WhatsApp para comercios y profesionales en Tortuguitas y toda Zona Norte.
        </p>

        <div class="flex items-center gap-2 text-xs text-slate-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Tortuguitas, Malvinas Argentinas, Buenos Aires</span>
        </div>
      </div>

      <!-- Quick Links (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3">
          Navegación
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#trabajos" class="hover:text-brand-primary transition-colors">Trabajos Reales (Casos de Éxito)</a></li>
          <li><a href="#servicios" class="hover:text-brand-primary transition-colors">Servicios para Negocios</a></li>
          <li><a href="#cotizador" class="hover:text-brand-primary transition-colors">Cotizador Rápido de Proyectos</a></li>
          <li><a href="#sobre-mi" class="hover:text-brand-primary transition-colors">Sobre Hernán Solís</a></li>
          <li><a href="#preguntas" class="hover:text-brand-primary transition-colors">Preguntas Frecuentes</a></li>
          <li><a href="#contacto" class="hover:text-brand-primary transition-colors">Contacto Directo</a></li>
          <li><a href="/cvGenerador.html" class="hover:text-brand-primary transition-colors text-slate-500">CV Técnico (Versión PDF)</a></li>
        </ul>
      </div>

      <!-- Projects / Work (4 cols) -->
      <div class="lg:col-span-4 space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3">
          Proyectos en Producción
        </h4>
        <div class="space-y-3">
          <a 
            href="https://tuiphonezonanorte.com.ar" 
            target="_blank" 
            rel="noopener noreferrer"
            class="block p-3 rounded-xl bg-dark-900 border border-slate-800/80 hover:border-brand-primary transition-colors group"
          >
            <div class="text-xs font-bold text-white group-hover:text-brand-primary transition-colors flex items-center justify-between">
              <span>Tu iPhone Zona Norte ↗</span>
              <span class="text-[10px] text-emerald-400 font-mono">Boutique Apple</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">
              Cotizador en tiempo real y ventas automáticas por WhatsApp (+18K IG).
            </p>
          </a>

          <a 
            href="https://arielstefanazzi.com.ar" 
            target="_blank" 
            rel="noopener noreferrer"
            class="block p-3 rounded-xl bg-dark-900 border border-slate-800/80 hover:border-brand-primary transition-colors group"
          >
            <div class="text-xs font-bold text-white group-hover:text-brand-primary transition-colors flex items-center justify-between">
              <span>Ariel Stefanazzi ↗</span>
              <span class="text-[10px] text-brand-cyan font-mono">Licitaciones & Gestoría</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">
              Plataforma institucional de alta velocidad (&lt;0.3s) y trámites directos.
            </p>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        © 2026 Hernán Solís. Desarrollado con <strong>Astro</strong> y <strong>Tailwind CSS</strong>. Desplegado en Cloudflare.
      </div>
      <div class="flex items-center gap-6">
        <a href={SITE_CONFIG.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">
          LinkedIn
        </a>
        <a href={SITE_CONFIG.github} target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">
          GitHub
        </a>
        <a href={footerWaLink} target="_blank" rel="noopener noreferrer" class="text-whatsapp hover:underline">
          WhatsApp: {SITE_CONFIG.whatsappDisplay}
        </a>
      </div>
    </div>

  </div>
</footer>
