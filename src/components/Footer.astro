---
import { SITE_CONFIG } from '../data/siteConfig';
import { FEATURED_PROJECTS } from '../data/projects';

const year = new Date().getFullYear();
---

<footer class="border-t border-line pt-16 md:pt-20 pb-10">
  <div class="wrap">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="/" class="font-display text-xl">hernán<span class="accent">.</span>solis</a>
        <p class="mt-4 text-sm text-muted leading-relaxed max-w-xs">
          Diseño y desarrollo de páginas web a medida en Tortuguitas, Zona Norte, Buenos Aires.
        </p>
      </div>

      <nav class="md:col-span-3" aria-label="Secciones">
        <p class="text-xs uppercase tracking-[0.14em] text-muted mb-4">Sitio</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#trabajos" class="u-link">Trabajos</a></li>
          <li><a href="#servicios" class="u-link">Servicios</a></li>
          <li><a href="#proceso" class="u-link">Proceso</a></li>
          <li><a href="#faq" class="u-link">Preguntas frecuentes</a></li>
          <li><a href="/cvGenerador.html" class="u-link">CV técnico</a></li>
        </ul>
      </nav>

      <div class="md:col-span-4">
        <p class="text-xs uppercase tracking-[0.14em] text-muted mb-4">Sitios en línea</p>
        <ul class="space-y-2.5 text-sm">
          {FEATURED_PROJECTS.map((p) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="u-link">{p.displayUrl} ↗</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-6 border-t border-line flex flex-col sm:flex-row gap-4 justify-between text-xs text-muted">
      <p>© {year} {SITE_CONFIG.name}</p>
      <div class="flex gap-6">
        <a href={SITE_CONFIG.linkedin} target="_blank" rel="noopener noreferrer" class="u-link hover:text-fg">LinkedIn</a>
        <a href={SITE_CONFIG.github} target="_blank" rel="noopener noreferrer" class="u-link hover:text-fg">GitHub</a>
        <a href={`mailto:${SITE_CONFIG.email}`} class="u-link hover:text-fg">Email</a>
      </div>
    </div>
  </div>
</footer>
