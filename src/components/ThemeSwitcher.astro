---
const THEMES = [
  { id: 'lima', name: 'Lima', note: 'Oscuro · original', bg: '#0b0c0a', accent: '#b5e36c' },
  { id: 'naranja', name: 'Naranja', note: 'Oscuro · cálido', bg: '#0b0c0a', accent: '#ff7a45' },
  { id: 'azul', name: 'Azul', note: 'Oscuro · tecnológico', bg: '#0b0c0a', accent: '#6b8cff' },
  { id: 'ambar', name: 'Ámbar', note: 'Oscuro · sobrio', bg: '#0b0c0a', accent: '#e8b65a' },
  { id: 'crema', name: 'Crema', note: 'Oscuro · monocromo', bg: '#0b0c0a', accent: '#efe9dc' },
  { id: 'noche', name: 'Noche', note: 'Azul noche · serif', bg: '#0d1017', accent: '#ff5d73' },
  { id: 'editorial', name: 'Editorial', note: 'Claro · serif', bg: '#f3efe6', accent: '#c2410c' },
  { id: 'papel', name: 'Papel', note: 'Claro · minimal', bg: '#fafaf7', accent: '#2e5bff' },
];
---

<div id="theme-switcher" class="fixed bottom-4 left-4 z-[60]">
  <div
    id="theme-panel"
    class="hidden absolute bottom-14 left-0 w-64 rounded-2xl border border-line bg-surface p-2 shadow-2xl"
    role="dialog"
    aria-label="Elegir diseño"
  >
    <p class="px-3 pt-2 pb-2 text-xs uppercase tracking-[0.14em] text-muted">Elegí un diseño</p>
    <ul class="space-y-0.5">
      {THEMES.map((t) => (
        <li>
          <button
            type="button"
            data-theme-id={t.id}
            class="theme-opt w-full flex items-center gap-3 px-3 py-2 rounded-xl text-left hover:bg-[var(--line)] transition-colors"
          >
            <span class="relative w-7 h-7 rounded-full border border-line shrink-0" style={`background:${t.bg}`} aria-hidden="true">
              <span class="absolute inset-[7px] rounded-full" style={`background:${t.accent}`}></span>
            </span>
            <span class="flex-1">
              <span class="block text-sm">{t.name}</span>
              <span class="block text-[11px] text-muted">{t.note}</span>
            </span>
            <span class="theme-check opacity-0 accent" aria-hidden="true">●</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <button
    id="theme-toggle"
    type="button"
    class="flex items-center gap-2 h-11 pl-3 pr-4 rounded-full border border-line-strong bg-surface shadow-xl text-sm"
    style="border-color: var(--line-strong)"
    aria-expanded="false"
    aria-controls="theme-panel"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.6-.8 1.6-1.6 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-4-4-7.4-9-7.4Z" stroke-linejoin="round"/>
      <circle cx="7.5" cy="11" r="1.2" fill="currentColor"/><circle cx="10.5" cy="7" r="1.2" fill="currentColor"/><circle cx="15.5" cy="7.5" r="1.2" fill="currentColor"/>
    </svg>
    <span>Diseño: <span id="theme-name">Lima</span></span>
  </button>
</div>

<script>
  const KEY = 'portfolio-theme';
  const root = document.documentElement;
  const panel = document.getElementById('theme-panel');
  const toggle = document.getElementById('theme-toggle');
  const nameEl = document.getElementById('theme-name');
  const opts = Array.from(document.querySelectorAll<HTMLButtonElement>('.theme-opt'));

  const apply = (id: string) => {
    if (id === 'lima') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', id);
    try { localStorage.setItem(KEY, id); } catch {}
    opts.forEach((o) => {
      const active = o.dataset.themeId === id;
      o.querySelector('.theme-check')?.classList.toggle('opacity-0', !active);
      o.setAttribute('aria-pressed', String(active));
      if (active && nameEl) nameEl.textContent = o.querySelector('.text-sm')?.textContent ?? id;
    });
    const meta = document.querySelector('meta[name="theme-color"]');
    meta?.setAttribute('content', getComputedStyle(root).getPropertyValue('--bg').trim());
  };

  const setOpen = (open: boolean) => {
    panel?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  apply(root.getAttribute('data-theme') ?? 'lima');
  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(panel?.classList.contains('hidden') ?? false);
  });
  opts.forEach((o) => o.addEventListener('click', () => apply(o.dataset.themeId ?? 'lima')));
  document.addEventListener('click', (e) => {
    if (!document.getElementById('theme-switcher')?.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
