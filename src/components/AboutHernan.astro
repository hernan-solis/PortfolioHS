---
import { SITE_CONFIG } from '../data/siteConfig';

const reasons = [
  { title: 'Hablás con quien programa', desc: 'Nada de teléfono descompuesto entre vendedor, diseñador y desarrollador.' },
  { title: 'El sitio es tuyo', desc: 'Código, dominio y contenido a tu nombre. Sin mensualidades cautivas.' },
  { title: 'Hecho desde cero', desc: 'Sin plantillas pesadas ni plugins: carga rápido y Google lo premia.' },
];
---

<section id="sobre-mi" class="py-24 md:py-36 border-t border-line">
  <div class="wrap grid md:grid-cols-12 gap-12 md:gap-16 items-center">
    <div class="md:col-span-5" data-reveal>
      <div class="relative max-w-sm mx-auto md:mx-0">
        <div class="aspect-[4/5] rounded-2xl overflow-hidden bg-surface border border-line">
          <img
            src="/assets/img/imgFotoPerfilEditado_websize.jpg"
            alt="Hernán Solis, desarrollador web en Tortuguitas"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="absolute -bottom-5 left-5 sm:left-auto sm:-right-6 rounded-xl bg-accent text-[var(--accent-ink)] px-4 py-3 shadow-xl">
          <p class="font-display text-sm">Hernán Solis</p>
          <p class="text-xs opacity-80 mt-0.5">Programador · Tortuguitas</p>
        </div>
      </div>
    </div>

    <div class="md:col-span-7">
      <div data-reveal>
        <p class="eyebrow">Sobre mí</p>
        <h2 class="mt-5 text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.12]">
          Una persona, <span class="accent">no una agencia</span>
        </h2>
        <div class="mt-6 space-y-4 text-muted leading-relaxed text-[1.05rem]">
          <p>
            Vivo en Tortuguitas y estudio la Tecnicatura Universitaria en Programación en la UTN. Vengo del desarrollo de software con C#, .NET y SQL, y hoy hago webs para comercios y empresas con Astro y Tailwind.
          </p>
          <p>
            Me gusta entender cómo funciona tu negocio antes de diseñar nada. Una web tiene que traer clientes, no solo verse bien.
          </p>
        </div>
      </div>

      <ul class="mt-10 grid sm:grid-cols-3 gap-6 border-t border-line pt-8">
        {reasons.map((r, i) => (
          <li data-reveal style={`--d: ${0.1 + i * 0.1}s`}>
            <h3 class="font-sans font-medium text-[0.95rem] tracking-normal">{r.title}</h3>
            <p class="mt-2 text-sm text-muted leading-relaxed">{r.desc}</p>
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4" data-reveal>
        <a href="#contacto" class="btn btn-solid">
          Contame tu proyecto
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href={SITE_CONFIG.linkedin} target="_blank" rel="noopener noreferrer" class="u-link text-sm text-muted hover:text-fg">LinkedIn ↗</a>
        <a href={SITE_CONFIG.github} target="_blank" rel="noopener noreferrer" class="u-link text-sm text-muted hover:text-fg">GitHub ↗</a>
      </div>
    </div>
  </div>
</section>
