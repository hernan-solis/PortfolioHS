---
const links = [
  { href: '#trabajos', label: 'Trabajos' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#faq', label: 'Preguntas' },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color] duration-300 border-b border-transparent">
  <nav class="wrap flex h-16 md:h-20 items-center justify-between" aria-label="Principal">
    <a href="/" class="font-display text-[15px] md:text-base tracking-tight" aria-label="Hernán Solis, inicio">
      hernán<span class="accent">.</span>solis
    </a>

    <ul class="hidden md:flex items-center gap-8 text-sm text-muted">
      {links.map((l) => (
        <li><a href={l.href} class="u-link hover:text-fg transition-colors">{l.label}</a></li>
      ))}
    </ul>

    <a href="#contacto" class="btn btn-ghost hidden md:inline-flex !py-2.5 !px-4 text-sm">
      Escribime
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>

    <button id="menu-btn" class="md:hidden -mr-2 p-2" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <span class="block w-6 h-px bg-fg mb-1.5 transition-transform duration-300" data-bar="1"></span>
      <span class="block w-6 h-px bg-fg transition-transform duration-300" data-bar="2"></span>
    </button>
  </nav>

  <div id="mobile-menu" class="md:hidden hidden border-t border-line bg-ink">
    <ul class="wrap py-6 flex flex-col gap-1">
      {links.map((l) => (
        <li><a href={l.href} class="block py-3 font-display text-2xl">{l.label}</a></li>
      ))}
      <li class="pt-4"><a href="#contacto" class="btn btn-solid w-full">Escribime</a></li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => {
    const scrolled = window.scrollY > 24;
    header?.classList.toggle('is-scrolled', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.querySelector('[data-bar="1"]')?.classList.toggle('translate-y-[3.5px]', open);
    btn?.querySelector('[data-bar="1"]')?.classList.toggle('rotate-45', open);
    btn?.querySelector('[data-bar="2"]')?.classList.toggle('-translate-y-[3.5px]', open);
    btn?.querySelector('[data-bar="2"]')?.classList.toggle('-rotate-45', open);
    if (open) header?.classList.add('bg-ink');
    else header?.classList.remove('bg-ink');
  };

  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
