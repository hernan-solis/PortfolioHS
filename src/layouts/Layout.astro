---
import '../styles/global.css';
import { SITE_CONFIG } from '../data/siteConfig';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = "Hernán Solís — Software, Desarrollo Web & Productos Digitales",
  description = "Desarrollador web y programador en Zona Norte. Sitios web a medida, plataformas digitales, catálogos online y software de alto rendimiento para comercios y profesionales.",
  canonical = SITE_CONFIG.siteUrl,
  image = `${SITE_CONFIG.siteUrl}/assets/img/imgFotoPerfilEditado_websize.jpg`,
} = Astro.props;

const canonicalURL = canonical.startsWith('http') ? canonical : `${SITE_CONFIG.siteUrl}${canonical}`;
const absoluteImageUrl = image.startsWith('http') ? image : `${SITE_CONFIG.siteUrl}${image}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["ProfessionalService", "LocalBusiness"],
      "@id": `${SITE_CONFIG.siteUrl}/#business`,
      "name": "Hernán Solís — Desarrollo Web en Zona Norte",
      "alternateName": "Hernán Solís Programador Web",
      "url": SITE_CONFIG.siteUrl,
      "logo": absoluteImageUrl,
      "image": absoluteImageUrl,
      "email": SITE_CONFIG.email,
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tortuguitas",
        "addressRegion": "Buenos Aires",
        "addressCountry": "AR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -34.4697,
        "longitude": -58.7583
      },
      "areaServed": SITE_CONFIG.coverageZones.map(zone => ({
        "@type": "AdministrativeArea",
        "name": zone
      })),
      "sameAs": [
        SITE_CONFIG.linkedin,
        SITE_CONFIG.github
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "09:00",
          "closes": "20:00"
        }
      ]
    },
    {
      "@type": "Person",
      "@id": `${SITE_CONFIG.siteUrl}/#person`,
      "name": "Hernán Abel Solís",
      "jobTitle": "Desarrollador Web & Programador",
      "url": SITE_CONFIG.siteUrl,
      "image": absoluteImageUrl,
      "sameAs": [
        SITE_CONFIG.linkedin,
        SITE_CONFIG.github
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="desarrollador web tortuguitas, paginas web zona norte, desarrollo web pilar, aplicaciones web saas, diseno web san miguel, programador freelance argentina, hernan solis" />
    <meta name="author" content="Hernán Solís" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Geo Tags para SEO Local (Tortuguitas / Zona Norte) -->
    <meta name="geo.region" content="AR-B" />
    <meta name="geo.placename" content="Tortuguitas, Malvinas Argentinas, Zona Norte, Buenos Aires" />
    <meta name="geo.position" content="-34.4697;-58.7583" />
    <meta name="ICBM" content="-34.4697, -58.7583" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Hernán Solís — Software & Desarrollo Web" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />

    <!-- Favicon & Theme -->
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico" />
    <meta name="theme-color" content="#030712" />
    <meta name="color-scheme" content="dark" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[#030712] text-slate-100 min-h-screen flex flex-col relative selection:bg-teal-500/20 selection:text-teal-300">
    
    <!-- Background atmospheric glows -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <div class="bg-orb w-[420px] h-[420px] -top-32 -left-32 bg-brand/[0.08]" style="animation-delay: 0s;"></div>
      <div class="bg-orb w-[380px] h-[380px] top-1/3 -right-32 bg-accent/[0.06]" style="animation-delay: 3s;"></div>
      <div class="bg-orb w-[300px] h-[300px] bottom-10 left-1/4 bg-cyan/[0.05]" style="animation-delay: 6s;"></div>
    </div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <!-- Scroll Reveal Script -->
    <script>
      const els = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
