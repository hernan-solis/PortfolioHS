---
import Layout from '../../layouts/Layout.astro';
import DesignSwitcher from '../../components/DesignSwitcher.astro';
import ContactHidden from '../../components/ContactHidden.astro';
import { SITE_CONFIG } from '../../data/siteConfig';
import { FEATURED_PROJECTS, PROTOTYPES } from '../../data/projects';
import { HERO, SERVICES, STEPS, ABOUT, REASONS, FAQS, CONTACT_OPTIONS, INCLUDED } from '../../data/content';

const statement = `${ABOUT.paragraphs[1]} ${REASONS.map((r) => r.title + '.').join(' ')}`;
const allWork = [
  ...FEATURED_PROJECTS.map((p) => ({ client: p.client, sub: p.displayUrl, url: p.url, shot: p.shotDesktop, kind: 'Publicado' })),
  ...PROTOTYPES.map((p) => ({ client: p.client, sub: p.sector, url: p.url, shot: p.shotDesktop, kind: 'Prototipo' })),
];
---

<Layout noindex bodyClass="d-kin" fonts="family=Anton&family=Inter:wght@400;500;600">
  <div class="kn-cursor" aria-hidden="true"></div>

  <header class="kn-nav">
    <div class="kn-wrap flex items-center justify-between h-16">
      <a href="/disenos/cinetico/" class="kn-mono font-semibold">HERNÁN SOLIS®</a>
      <nav class="hidden md:flex gap-8 kn-mono" aria-label="Principal">
        <a href="#trabajos" class="kn-navlink">Trabajos</a>
        <a href="#servicios" class="kn-navlink">Servicios</a>
        <a href="#proceso" class="kn-navlink">Proceso</a>
        <a href="#faq" class="kn-navlink">FAQ</a>
      </nav>
      <a href="#contacto" class="kn-mono kn-navlink">Contacto ↘</a>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="kn-hero">
      <div class="kn-wrap">
        <p class="kn-mono fade-in">{HERO.eyebrow}</p>
        <h1 class="kn-giant mt-6" aria-label={HERO.title}>
          <span class="line-mask"><span style="--d:.05s">Webs</span></span>
          <span class="line-mask kn-row"><span style="--d:.15s">a medida</span><img src={ABOUT.photo} alt="" class="kn-face fade-in" style="--d:.7s" /></span>
          <span class="line-mask"><span style="--d:.25s" class="kn-ghost">Zona Norte</span></span>
        </h1>
        <div class="grid md:grid-cols-12 gap-8 mt-10 md:mt-14 items-end">
          <p class="md:col-span-6 text-lg leading-relaxed kn-dim fade-in" style="--d:.5s">{HERO.lead}</p>
          <div class="md:col-span-6 md:text-right fade-in" style="--d:.6s">
            <a href="#contacto" class="kn-btn">Pedir presupuesto <span class="kn-btn-arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Zones: two opposing rows -->
    <div class="kn-tape" aria-label="Zonas donde trabajo">
      <div class="marquee">
        {[0, 1].map((c) => (
          <ul class="marquee-track" aria-hidden={c === 1 ? 'true' : undefined}>
            {SITE_CONFIG.coverageZones.map((z) => <li class="whitespace-nowrap">{z} <span class="kn-star">✺</span></li>)}
          </ul>
        ))}
      </div>
      <div class="marquee kn-reverse" aria-hidden="true">
        {[0, 1].map(() => (
          <ul class="marquee-track">
            {[...INCLUDED, 'Hecho desde cero', 'Sin comisiones'].map((z) => <li class="whitespace-nowrap">{z} <span class="kn-star">✺</span></li>)}
          </ul>
        ))}
      </div>
    </div>

    <!-- Work: horizontal scroll pinned on desktop -->
    <section id="trabajos" class="kn-hscroll" data-hscroll>
      <div class="kn-hsticky">
        <div class="kn-wrap flex items-end justify-between gap-6 pt-20 md:pt-0">
          <h2 class="kn-big">Trabajos <sup class="kn-mono kn-sup">({allWork.length})</sup></h2>
          <p class="kn-mono kn-dim hidden md:block">Scrolleá →</p>
        </div>
        <div class="kn-track" data-track>
          {allWork.map((w, i) => (
            <a href={w.url} target="_blank" rel="noopener noreferrer" class="kn-slide group">
              <div class="kn-slide-img">
                <img src={w.shot} alt={`Página de ${w.client}`} loading="lazy" decoding="async" class="w-full h-full object-cover object-top" />
              </div>
              <div class="flex justify-between items-start gap-4 mt-4">
                <div>
                  <h3 class="kn-slide-title">{w.client}</h3>
                  <p class="kn-mono kn-dim mt-1">{w.sub}</p>
                </div>
                <span class="kn-mono shrink-0">{String(i + 1).padStart(2, '0')} / {w.kind}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Statement: words light up on scroll -->
    <section class="kn-wrap py-24 md:py-40">
      <p class="kn-mono kn-dim mb-8">{ABOUT.title}</p>
      <p class="kn-statement" data-words>{statement}</p>
    </section>

    <!-- Services: inverted -->
    <section id="servicios" class="kn-invert py-20 md:py-32">
      <div class="kn-wrap">
        <h2 class="kn-big" data-reveal>Servicios</h2>
        <div class="mt-12 md:mt-16">
          {SERVICES.map((s, i) => (
            <article class="kn-service group" data-reveal>
              <span class="kn-mono">0{i + 1}</span>
              <h3 class="kn-service-title">{s.short}</h3>
              <div class="kn-service-body">
                <p class="font-semibold text-lg">{s.title}</p>
                <p class="mt-2 leading-relaxed opacity-75">{s.desc}</p>
                <p class="kn-mono mt-4">{s.items.join(' / ')}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Process: sticky stacked cards -->
    <section id="proceso" class="kn-wrap py-24 md:py-32">
      <h2 class="kn-big" data-reveal>Proceso</h2>
      <ol class="mt-12">
        {STEPS.map((s, i) => (
          <li class="kn-stack" style={`--i:${i}`}>
            <span class="kn-stack-n">{i + 1}</span>
            <div class="max-w-xl">
              <h3 class="kn-stack-title">{s.title}</h3>
              <p class="mt-3 text-lg leading-relaxed opacity-80">{s.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- About -->
    <section class="kn-wrap py-16 md:py-24">
      <div class="grid md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-5" data-reveal>
          <div class="kn-portrait"><img src={ABOUT.photo} alt="Hernán Solis" loading="lazy" class="w-full aspect-[4/5] object-cover" /></div>
        </div>
        <div class="md:col-span-7" data-reveal style="--d:.1s">
          <p class="kn-mono kn-dim">Sobre mí</p>
          <p class="text-2xl md:text-3xl leading-snug mt-4 font-medium">{ABOUT.paragraphs[0]}</p>
          <ul class="mt-10 grid gap-0">
            {REASONS.map((r) => (
              <li class="kn-row-line">
                <span class="font-semibold">{r.title}</span>
                <span class="kn-dim text-sm md:text-right">{r.desc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="kn-wrap py-16 md:py-24">
      <h2 class="kn-big" data-reveal>Preguntas</h2>
      <div class="mt-10 border-t kn-border">
        {FAQS.map((f) => (
          <details class="faq border-b kn-border" data-reveal>
            <summary class="flex justify-between items-center gap-6 py-6">
              <span class="text-lg md:text-2xl font-medium">{f.q}</span>
              <span class="plus kn-plus" aria-hidden="true">+</span>
            </summary>
            <div class="faq-body"><div class="overflow-hidden"><p class="pb-6 max-w-2xl kn-dim leading-relaxed text-lg">{f.a}</p></div></div>
          </details>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section id="contacto" class="kn-invert pt-20 md:pt-32 pb-32">
      <div class="kn-wrap">
        <h2 class="kn-giant kn-giant-contact" data-reveal>Hablemos</h2>
        <div class="grid md:grid-cols-12 gap-10 mt-12">
          <div class="md:col-span-5" data-reveal>
            <p class="text-lg leading-relaxed opacity-80">Escribime con tu idea, aunque sea un borrador. Te respondo con preguntas o un presupuesto.</p>
            <a href={`mailto:${SITE_CONFIG.email}`} class="inline-block mt-6 text-xl font-semibold underline underline-offset-8 break-all">{SITE_CONFIG.email}</a>
          </div>
          <form data-contact-form action={SITE_CONFIG.contactFormEndpoint} method="POST" class="md:col-span-7 grid gap-2" data-reveal style="--d:.1s">
            <ContactHidden />
            <input name="name" required placeholder="Nombre" autocomplete="name" class="kn-input" aria-label="Nombre" />
            <input name="email" type="email" required placeholder="Email" autocomplete="email" class="kn-input" aria-label="Email" />
            <select name="tipo" class="kn-input" aria-label="Qué necesitás">
              {CONTACT_OPTIONS.map((o) => <option>{o}</option>)}
            </select>
            <textarea name="message" rows="3" required placeholder="Contame sobre tu negocio" class="kn-input resize-none" aria-label="Mensaje"></textarea>
            <button type="submit" class="kn-btn kn-btn-inv mt-6 justify-self-start"><span data-submit-label>Enviar</span> <span class="kn-btn-arrow" aria-hidden="true">→</span></button>
            <p data-status role="status" aria-live="polite" class="text-sm"></p>
          </form>
        </div>
      </div>
      <footer class="kn-wrap mt-24 flex flex-col sm:flex-row justify-between gap-3 kn-mono">
        <p>© {new Date().getFullYear()} Hernán Solis</p>
        <p class="flex gap-6">
          <a href={SITE_CONFIG.linkedin} target="_blank" rel="noopener noreferrer" class="kn-navlink">LinkedIn</a>
          <a href={SITE_CONFIG.github} target="_blank" rel="noopener noreferrer" class="kn-navlink">GitHub</a>
        </p>
      </footer>
    </section>
  </main>

  <DesignSwitcher current="cinetico" />
</Layout>

<style is:global>
  body.d-kin {
    --kn-bg: #f2f2ee;
    --kn-fg: #0c0c0c;
    --accent: #0c0c0c;
    background: var(--kn-bg);
    color: var(--kn-fg);
    font-family: 'Inter', system-ui, sans-serif;
  }
  html:has(body.d-kin) { background: #f2f2ee; color-scheme: light; }
  body.d-kin ::selection { background: #0c0c0c; color: #f2f2ee; }
  .d-kin h1, .d-kin h2, .d-kin h3 { font-family: 'Anton', Impact, sans-serif; font-weight: 400; letter-spacing: 0; }
  .d-kin .kn-wrap { max-width: 90rem; margin-inline: auto; padding-inline: 1rem; }
  @media (min-width: 640px) { .d-kin .kn-wrap { padding-inline: 2rem; } }
  .d-kin .kn-mono { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; font-weight: 500; }
  .d-kin .kn-dim { opacity: .6; }
  .d-kin .kn-border { border-color: rgba(12, 12, 12, .2); }

  .d-kin .kn-nav { position: fixed; inset: 0 0 auto; z-index: 50; mix-blend-mode: difference; color: #fff; }
  .d-kin .kn-navlink { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .35s var(--ease); padding-bottom: 2px; }
  .d-kin .kn-navlink:hover { background-size: 100% 1px; }

  .d-kin .kn-hero { min-height: 100svh; display: flex; align-items: flex-end; padding: 7rem 0 3rem; }
  .d-kin .kn-giant { font-family: 'Anton', Impact, sans-serif; text-transform: uppercase; font-size: clamp(4.2rem, min(17vw, 22vh), 17rem); line-height: .86; }
  .d-kin .kn-giant .line-mask { display: block; }
  .d-kin .kn-row > span:first-child { display: inline-block; }
  .d-kin .kn-row { display: flex !important; align-items: center; gap: .15em; }
  .d-kin .kn-face { height: .72em; width: auto; aspect-ratio: 1.6; object-fit: cover; border-radius: 999px; filter: grayscale(1); }
  .d-kin .kn-ghost { color: transparent; -webkit-text-stroke: 2px var(--kn-fg); }

  .d-kin .kn-btn { display: inline-flex; align-items: center; gap: .8rem; padding: 1.1rem 1.1rem 1.1rem 1.6rem; border-radius: 999px; background: var(--kn-fg); color: var(--kn-bg); font-weight: 600; transition: gap .35s var(--ease); }
  .d-kin .kn-btn:hover { gap: 1.4rem; }
  .d-kin .kn-btn-arrow { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 99px; background: var(--kn-bg); color: var(--kn-fg); }
  .d-kin .kn-btn-inv { background: var(--kn-bg); color: var(--kn-fg); }
  .d-kin .kn-btn-inv .kn-btn-arrow { background: var(--kn-fg); color: var(--kn-bg); }

  .d-kin .kn-tape { background: var(--kn-fg); color: var(--kn-bg); padding: .6rem 0; font-family: 'Anton'; text-transform: uppercase; font-size: clamp(1.6rem, 4vw, 3.2rem); line-height: 1.2; }
  .d-kin .kn-tape .marquee { mask-image: none; -webkit-mask-image: none; }
  .d-kin .kn-tape .marquee-track { animation-duration: 30s; }
  .d-kin .kn-reverse { opacity: .45; }
  .d-kin .kn-reverse .marquee-track { animation-direction: reverse; }
  .d-kin .kn-star { display: inline-block; font-size: .6em; vertical-align: middle; margin-left: 2.5rem; }

  .d-kin .kn-big { font-size: clamp(3.2rem, 10vw, 9rem); line-height: .9; text-transform: uppercase; }
  .d-kin .kn-sup { vertical-align: top; font-family: 'Inter'; }

  /* Horizontal scroll */
  .d-kin .kn-track { display: grid; gap: 2rem; padding: 2.5rem 1rem 0; }
  .d-kin .kn-slide { display: block; }
  .d-kin .kn-slide-img { overflow: hidden; aspect-ratio: 16 / 10; background: #ddd; border-radius: 6px; }
  .d-kin .kn-slide-img img { transition: transform 1s var(--ease), filter .6s; filter: grayscale(1); }
  .d-kin .kn-slide:hover .kn-slide-img img { transform: scale(1.04); filter: none; }
  .d-kin .kn-slide-title { font-size: clamp(1.8rem, 3vw, 2.6rem); text-transform: uppercase; line-height: 1; }
  @media (min-width: 768px) {
    .d-kin .kn-hscroll.is-pinned { height: var(--h, 400vh); }
    .d-kin .is-pinned .kn-hsticky { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; justify-content: center; overflow: hidden; }
    .d-kin .is-pinned .kn-track { display: flex; gap: 2.5rem; padding: 3rem 2rem 0; width: max-content; will-change: transform; }
    .d-kin .is-pinned .kn-slide { width: min(46vw, 640px); }
    .d-kin .kn-hscroll:not(.is-pinned) .kn-track { grid-template-columns: repeat(2, 1fr); max-width: 90rem; margin-inline: auto; padding-inline: 2rem; }
  }
  @media (max-width: 767px) { .d-kin .kn-hscroll { padding-bottom: 4rem; } }

  .d-kin .kn-statement { font-size: clamp(2rem, 5.4vw, 4.8rem); line-height: 1.08; font-weight: 600; letter-spacing: -0.03em; max-width: 22ch; }
  .d-kin .kn-statement .w { opacity: .14; transition: opacity .3s; }
  .d-kin .kn-statement .w.on { opacity: 1; }

  .d-kin .kn-invert { background: var(--kn-fg); color: var(--kn-bg); }
  .d-kin .kn-invert .kn-ghost { -webkit-text-stroke-color: var(--kn-bg); }
  .d-kin .kn-service { display: grid; gap: 1rem; padding: 2rem 0; border-top: 1px solid rgba(242, 242, 238, .2); align-items: start; }
  .d-kin .kn-service:last-child { border-bottom: 1px solid rgba(242, 242, 238, .2); }
  @media (min-width: 900px) { .d-kin .kn-service { grid-template-columns: 4rem 1fr 26rem; gap: 2rem; } }
  .d-kin .kn-service-title { font-size: clamp(3.4rem, 9vw, 8rem); line-height: .9; text-transform: uppercase; transition: transform .5s var(--ease), color .3s; }
  .d-kin .kn-service:hover .kn-service-title { transform: translateX(1.5rem); color: transparent; -webkit-text-stroke: 2px var(--kn-bg); }

  .d-kin .kn-stack { position: sticky; top: calc(5rem + var(--i) * 1.5rem); display: flex; gap: 1.5rem 3rem; flex-wrap: wrap; align-items: flex-start; padding: 2rem; margin-bottom: 1.5rem; min-height: 15rem; border-radius: 14px; background: var(--kn-bg); border: 1.5px solid var(--kn-fg); box-shadow: 0 -10px 30px rgba(0,0,0,.06); }
  .d-kin .kn-stack:nth-child(even) { background: var(--kn-fg); color: var(--kn-bg); }
  .d-kin .kn-stack-n { font-family: 'Anton'; font-size: clamp(5rem, 12vw, 9rem); line-height: .8; }
  .d-kin .kn-stack-title { font-size: clamp(2.2rem, 5vw, 4rem); text-transform: uppercase; line-height: 1; }

  .d-kin .kn-portrait { overflow: hidden; border-radius: 6px; }
  .d-kin .kn-portrait img { filter: grayscale(1) contrast(1.05); transition: transform 1.2s var(--ease); }
  .d-kin .kn-portrait:hover img { transform: scale(1.04); }
  .d-kin .kn-row-line { display: grid; gap: .25rem; padding: 1rem 0; border-top: 1px solid rgba(12,12,12,.2); }
  @media (min-width: 768px) { .d-kin .kn-row-line { grid-template-columns: 1fr 1fr; gap: 2rem; } }
  .d-kin .kn-plus { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 99px; border: 1.5px solid currentColor; flex-shrink: 0; font-size: 22px; }

  .d-kin .kn-giant-contact { font-size: clamp(4.5rem, 20vw, 19rem); }
  .d-kin .kn-input { width: 100%; background: transparent; border: 0; border-bottom: 1px solid rgba(242,242,238,.3); padding: 1.1rem 0; color: var(--kn-bg); font: inherit; font-size: 1.25rem; border-radius: 0; transition: border-color .25s; }
  .d-kin .kn-input::placeholder { color: rgba(242,242,238,.45); }
  .d-kin .kn-input:focus { outline: none; border-color: var(--kn-bg); }
  .d-kin select.kn-input option { color: #111; }
  .d-kin .kn-invert :focus-visible { outline-color: var(--kn-bg); }

  .d-kin .kn-cursor { position: fixed; top: 0; left: 0; z-index: 60; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 99px; background: #fff; mix-blend-mode: difference; pointer-events: none; opacity: 0; transition: width .3s var(--ease), height .3s var(--ease), margin .3s var(--ease), opacity .3s; }
  .d-kin .kn-cursor.is-on { opacity: 1; }
  .d-kin .kn-cursor.is-big { width: 72px; height: 72px; margin: -36px 0 0 -36px; }
  @media (hover: none) { .d-kin .kn-cursor { display: none; } }
  @media (prefers-reduced-motion: reduce) { .d-kin .kn-statement .w { opacity: 1; } .d-kin .kn-cursor { display: none; } }
</style>

<script>
  import { bindContactForms } from '../../scripts/contact-form';
  bindContactForms();

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Statement: wrap each word so it can light up with scroll
  const statement = document.querySelector<HTMLElement>('[data-words]');
  let words: HTMLElement[] = [];
  if (statement && !reduce) {
    const text = statement.textContent ?? '';
    statement.textContent = '';
    text.split(/\s+/).forEach((w, i, arr) => {
      const span = document.createElement('span');
      span.className = 'w';
      span.textContent = w;
      statement.append(span, i < arr.length - 1 ? ' ' : '');
    });
    words = Array.from(statement.querySelectorAll<HTMLElement>('.w'));
  }

  // Work: pinned horizontal scroll on wide screens
  const section = document.querySelector<HTMLElement>('[data-hscroll]');
  const track = document.querySelector<HTMLElement>('[data-track]');
  const wide = window.matchMedia('(min-width: 768px)');
  let distance = 0;

  const setupPin = () => {
    if (!section || !track) return;
    const pin = wide.matches && !reduce;
    section.classList.toggle('is-pinned', pin);
    track.style.transform = '';
    if (!pin) return;
    distance = Math.max(0, track.scrollWidth - window.innerWidth);
    section.style.setProperty('--h', `${window.innerHeight + distance}px`);
  };

  const onScroll = () => {
    if (section && track && section.classList.contains('is-pinned')) {
      const top = section.getBoundingClientRect().top;
      const progress = Math.min(1, Math.max(0, -top / distance || 0));
      track.style.transform = `translate3d(${-progress * distance}px, 0, 0)`;
    }
    if (statement && words.length) {
      const r = statement.getBoundingClientRect();
      const vh = window.innerHeight;
      const progress = Math.min(1, Math.max(0, (vh * 0.8 - r.top) / (r.height + vh * 0.3)));
      const lit = Math.round(progress * words.length);
      words.forEach((w, i) => w.classList.toggle('on', i < lit));
    }
  };

  setupPin();
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => { setupPin(); onScroll(); });
  window.addEventListener('load', () => { setupPin(); onScroll(); });

  // Custom cursor (pointer devices only)
  const cursor = document.querySelector<HTMLElement>('.kn-cursor');
  if (cursor && window.matchMedia('(hover: hover)').matches && !reduce) {
    window.addEventListener('pointermove', (e) => {
      cursor.classList.add('is-on');
      cursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
      cursor.classList.toggle('is-big', !!(e.target as Element).closest('a, button, summary'));
    });
    document.addEventListener('pointerleave', () => cursor.classList.remove('is-on'));
  }
</script>
