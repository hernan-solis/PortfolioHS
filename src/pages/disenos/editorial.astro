---
import Layout from '../../layouts/Layout.astro';
import DesignSwitcher from '../../components/DesignSwitcher.astro';
import ContactHidden from '../../components/ContactHidden.astro';
import { SITE_CONFIG } from '../../data/siteConfig';
import { FEATURED_PROJECTS, PROTOTYPES } from '../../data/projects';
import { HERO, SERVICES, STEPS, ABOUT, REASONS, FAQS, CONTACT_OPTIONS } from '../../data/content';

const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---

<Layout
  noindex
  bodyClass="d-editorial"
  fonts="family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600"
>
  <header class="ed-wrap pt-5">
    <div class="flex items-center justify-between text-[11px] sm:text-xs uppercase tracking-[0.16em] ed-muted">
      <span>Nº 01 · Tortuguitas, Bs. As.</span>
      <nav class="hidden md:flex gap-7" aria-label="Principal">
        <a href="#trabajos" class="ed-link">Trabajos</a>
        <a href="#servicios" class="ed-link">Servicios</a>
        <a href="#sobre-mi" class="ed-link">Sobre mí</a>
        <a href="#preguntas" class="ed-link">Preguntas</a>
      </nav>
      <a href="#contacto" class="ed-link ed-ink">Escribime →</a>
    </div>
    <div class="ed-rule-double mt-4"></div>
    <a href="/disenos/editorial/" class="block text-center ed-serif italic text-[2.6rem] sm:text-6xl md:text-7xl leading-none py-4 md:py-6">
      Hernán Solis
    </a>
    <div class="ed-rule"></div>
    <p class="text-center text-[11px] sm:text-xs uppercase tracking-[0.2em] py-2.5 ed-muted">
      Diseño y desarrollo web · Zona Norte · Desde Tortuguitas para todo el país
    </p>
    <div class="ed-rule"></div>
  </header>

  <main>
    <!-- Hero -->
    <section class="ed-wrap pt-14 md:pt-24 pb-16 md:pb-28">
      <h1 class="ed-serif ed-display">
        <span class="ed-line"><span style="--d:.05s">Páginas web <em class="ed-accent">a medida</em></span></span>
        <span class="ed-line"><span style="--d:.18s">para negocios de</span></span>
        <span class="ed-line"><span style="--d:.31s">Zona Norte.</span></span>
      </h1>

      <div class="grid md:grid-cols-12 gap-8 md:gap-10 mt-12 md:mt-16 items-start">
        <p class="md:col-span-3 text-xs uppercase tracking-[0.16em] ed-muted leading-relaxed fade-in" style="--d:.5s">
          Por Hernán Solis<br />Programador · UTN
        </p>
        <p class="md:col-span-6 text-lg md:text-xl leading-relaxed ed-dropcap fade-in" style="--d:.6s">
          {HERO.lead}
        </p>
        <div class="md:col-span-3 flex md:flex-col gap-3 fade-in" style="--d:.7s">
          <a href="#contacto" class="ed-btn ed-btn-solid">Pedir presupuesto</a>
          <a href="#trabajos" class="ed-btn">Ver trabajos</a>
        </div>
      </div>
    </section>

    <!-- Featured work, magazine spreads -->
    <section id="trabajos" class="ed-wrap pb-10">
      <div class="ed-section-head" data-reveal>
        <span>Trabajos</span>
        <span class="ed-muted">Sitios publicados</span>
      </div>

      {FEATURED_PROJECTS.map((p, i) => (
        <article class="grid md:grid-cols-12 gap-6 md:gap-12 py-12 md:py-20 border-b ed-border items-center" data-reveal>
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['md:col-span-7 block group', i % 2 === 1 && 'md:order-2']}
            aria-label={`Ver ${p.client}`}
          >
            <figure>
              <div class="overflow-hidden ed-frame">
                <img src={p.shotDesktop} alt={`Página de inicio de ${p.client}`} loading="lazy" decoding="async" width="1440" height="900" class="w-full aspect-[16/10] object-cover object-top transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]" />
              </div>
              <figcaption class="mt-3 text-xs ed-muted flex justify-between">
                <span>Fig. {i + 1} — {p.displayUrl}</span>
                <span>{p.location}</span>
              </figcaption>
            </figure>
          </a>
          <div class:list={['md:col-span-5', i % 2 === 1 && 'md:order-1']}>
            <p class="text-xs uppercase tracking-[0.16em] ed-accent">Caso {roman[i]} · {p.client}</p>
            <h2 class="ed-serif text-3xl sm:text-4xl md:text-5xl leading-[1.05] mt-4">{p.title}</h2>
            <p class="mt-5 leading-relaxed ed-muted">{p.summary}</p>
            <p class="mt-5 text-sm">{p.highlights.join(' · ')}</p>
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="ed-link inline-block mt-6 text-sm">Visitar {p.displayUrl} ↗</a>
          </div>
        </article>
      ))}
    </section>

    <!-- Prototypes index with cursor preview -->
    <section class="ed-wrap py-16 md:py-24">
      <div class="ed-section-head" data-reveal>
        <span>Índice de prototipos</span>
        <span class="ed-muted">Propuestas en curso</span>
      </div>
      <ol class="ed-index" data-reveal>
        {PROTOTYPES.map((p, i) => (
          <li>
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="ed-index-row group" data-preview={p.shotDesktop}>
              <span class="ed-muted text-sm w-10 shrink-0">{String(i + 1).padStart(2, '0')}</span>
              <span class="ed-serif text-2xl sm:text-3xl md:text-5xl flex-1 transition-transform duration-500 group-hover:translate-x-3">{p.client}</span>
              <span class="hidden sm:block text-sm ed-muted w-56 text-right">{p.sector}</span>
              <span class="hidden md:block text-sm ed-muted w-40 text-right">{p.location}</span>
              <span class="ml-4 ed-accent" aria-hidden="true">↗</span>
            </a>
            <img src={p.shotDesktop} alt={`Prototipo de ${p.client}`} loading="lazy" decoding="async" class="md:hidden w-full aspect-[16/9] object-cover object-top mb-6 ed-frame" />
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm ed-muted max-w-xl">Prototipos funcionando para negocios de la zona. Todavía no están publicados con su dominio, pero se pueden recorrer.</p>
      <img id="ed-preview" alt="" aria-hidden="true" class="ed-preview" />
    </section>

    <!-- Services -->
    <section id="servicios" class="ed-wrap py-16 md:py-24">
      <div class="ed-section-head" data-reveal>
        <span>Servicios</span>
        <span class="ed-muted">Lo que hago</span>
      </div>
      <div class="grid md:grid-cols-3 md:divide-x ed-divide">
        {SERVICES.map((s, i) => (
          <article class="py-8 md:py-4 md:px-8 first:md:pl-0 last:md:pr-0 border-b md:border-b-0 ed-border" data-reveal style={`--d:${i * 0.1}s`}>
            <p class="ed-serif italic text-5xl ed-accent">{roman[i]}.</p>
            <h3 class="ed-serif text-3xl mt-4 leading-tight">{s.title}</h3>
            <p class="mt-4 leading-relaxed ed-muted">{s.desc}</p>
            <ul class="mt-5 text-sm space-y-1.5">
              {s.items.map((it) => <li>— {it}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <!-- Process -->
    <section class="ed-wrap py-16 md:py-24">
      <div class="ed-section-head" data-reveal>
        <span>Cómo trabajo</span>
        <span class="ed-muted">Cuatro pasos</span>
      </div>
      <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {STEPS.map((s, i) => (
          <li data-reveal style={`--d:${i * 0.08}s`}>
            <span class="ed-serif text-7xl md:text-8xl leading-none ed-accent">{i + 1}</span>
            <h3 class="ed-serif text-2xl mt-3">{s.title}</h3>
            <p class="mt-2 ed-muted leading-relaxed">{s.desc}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- About -->
    <section id="sobre-mi" class="ed-wrap py-16 md:py-24">
      <div class="ed-section-head" data-reveal>
        <span>Sobre mí</span>
        <span class="ed-muted">Entrevista breve</span>
      </div>
      <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start">
        <figure class="md:col-span-4" data-reveal>
          <img src={ABOUT.photo} alt="Hernán Solis" loading="lazy" class="w-full aspect-[4/5] object-cover ed-photo ed-frame" />
          <figcaption class="mt-3 text-xs ed-muted">Hernán Solis, en Tortuguitas.</figcaption>
        </figure>
        <div class="md:col-span-8" data-reveal style="--d:.1s">
          <blockquote class="ed-serif italic text-3xl sm:text-4xl md:text-6xl leading-[1.08]">
            “Una web tiene que traer clientes, no solo verse bien.”
          </blockquote>
          <div class="grid sm:grid-cols-2 gap-6 mt-10 leading-relaxed ed-muted">
            {ABOUT.paragraphs.map((t) => <p>{t}</p>)}
          </div>
          <ul class="mt-10 grid sm:grid-cols-3 gap-6 border-t ed-border pt-6">
            {REASONS.map((r) => (
              <li>
                <h3 class="ed-serif text-xl">{r.title}</h3>
                <p class="mt-1 text-sm ed-muted leading-relaxed">{r.desc}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="preguntas" class="ed-wrap py-16 md:py-24">
      <div class="ed-section-head" data-reveal>
        <span>Preguntas frecuentes</span>
        <span class="ed-muted">Correo de lectores</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-14">
        {FAQS.map((f, i) => (
          <details class="ed-faq border-b ed-border min-w-0" open={i === 0} data-reveal>
            <summary class="flex justify-between gap-6 py-5 cursor-pointer">
              <span class="ed-serif text-2xl leading-snug">{f.q}</span>
              <span class="ed-plus ed-accent text-2xl leading-none shrink-0 self-start mt-1 w-6 text-center" aria-hidden="true">+</span>
            </summary>
            <p class="pb-6 ed-muted leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section id="contacto" class="ed-wrap py-16 md:py-28">
      <div class="ed-rule-double mb-12"></div>
      <div class="grid md:grid-cols-12 gap-12">
        <div class="md:col-span-6" data-reveal>
          <h2 class="ed-serif ed-display-sm">Escribime<em class="ed-accent">.</em></h2>
          <p class="mt-6 text-lg ed-muted max-w-md leading-relaxed">Contame tu idea, aunque sea un borrador. Te respondo con preguntas o un presupuesto.</p>
          <a href={`mailto:${SITE_CONFIG.email}`} class="ed-serif italic text-2xl sm:text-3xl md:text-4xl mt-8 inline-block ed-link break-all">{SITE_CONFIG.email}</a>
        </div>
        <form data-contact-form action={SITE_CONFIG.contactFormEndpoint} method="POST" class="md:col-span-6 space-y-7" data-reveal style="--d:.1s">
          <ContactHidden />
          <div class="grid sm:grid-cols-2 gap-7">
            <label class="block"><span class="ed-label">Nombre</span><input name="name" required autocomplete="name" class="ed-field" /></label>
            <label class="block"><span class="ed-label">Email</span><input name="email" type="email" required autocomplete="email" class="ed-field" /></label>
          </div>
          <label class="block">
            <span class="ed-label">Qué necesitás</span>
            <select name="tipo" class="ed-field">
              {CONTACT_OPTIONS.map((o) => <option>{o}</option>)}
            </select>
          </label>
          <label class="block"><span class="ed-label">Mensaje</span><textarea name="message" rows="4" required class="ed-field resize-none"></textarea></label>
          <div class="flex flex-wrap items-center gap-5">
            <button type="submit" class="ed-btn ed-btn-solid"><span data-submit-label>Enviar mensaje</span></button>
            <p data-status role="status" aria-live="polite" class="text-sm"></p>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="ed-wrap pb-24">
    <div class="ed-rule"></div>
    <div class="flex flex-col sm:flex-row justify-between gap-3 py-5 text-xs ed-muted">
      <p>Colofón: compuesto en Instrument Serif e Inter Tight. Hecho a mano en Tortuguitas.</p>
      <p>© {new Date().getFullYear()} Hernán Solis · <a href={SITE_CONFIG.linkedin} class="ed-link" target="_blank" rel="noopener noreferrer">LinkedIn</a> · <a href={SITE_CONFIG.github} class="ed-link" target="_blank" rel="noopener noreferrer">GitHub</a></p>
    </div>
  </footer>

  <DesignSwitcher current="editorial" />
</Layout>

<style is:global>
  body.d-editorial {
    --bg: #f2ede4;
    --fg: #16130f;
    background: #f2ede4;
    color: #16130f;
    font-family: 'Inter Tight', system-ui, sans-serif;
  }
  html:has(body.d-editorial) { background: #f2ede4; color-scheme: light; }
  body.d-editorial ::selection { background: #b8441f; color: #fff; }
  .d-editorial h1, .d-editorial h2, .d-editorial h3 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; letter-spacing: -0.01em; }
  .d-editorial .ed-wrap { max-width: 82rem; margin-inline: auto; padding-inline: 1rem; }
  @media (min-width: 640px) { .d-editorial .ed-wrap { padding-inline: 1.75rem; } }
  @media (min-width: 1024px) { .d-editorial .ed-wrap { padding-inline: 2.5rem; } }
  .d-editorial .ed-serif { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; }
  .d-editorial .ed-muted { color: #6d675d; }
  .d-editorial .ed-ink { color: #16130f; }
  .d-editorial .ed-accent { color: #b8441f; }
  .d-editorial em.ed-accent { font-style: italic; }
  .d-editorial .ed-border { border-color: rgba(22, 19, 15, 0.18); }
  .d-editorial .ed-divide > * + * { border-color: rgba(22, 19, 15, 0.18); }
  .d-editorial .ed-rule { height: 1px; background: #16130f; }
  .d-editorial .ed-rule-double { height: 5px; border-top: 2px solid #16130f; border-bottom: 1px solid #16130f; }
  .d-editorial .ed-display { font-size: clamp(3rem, 10.5vw, 9.5rem); line-height: 0.92; letter-spacing: -0.025em; }
  .d-editorial .ed-display-sm { font-size: clamp(3.2rem, 9vw, 8rem); line-height: 0.95; }
  .d-editorial .ed-line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .d-editorial .ed-line > span { display: inline-block; transform: translateY(105%); animation: lineUp 1.1s var(--ease) forwards; animation-delay: var(--d, 0s); }
  .d-editorial .ed-dropcap::first-letter {
    font-family: 'Instrument Serif', Georgia, serif;
    float: left;
    font-size: 4.6em;
    line-height: 0.8;
    padding: 0.06em 0.1em 0 0;
    color: #b8441f;
  }
  .d-editorial .ed-link { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 0.4s var(--ease); }
  .d-editorial .ed-link:hover { background-size: 100% 1px; }
  .d-editorial .ed-btn {
    display: inline-flex; justify-content: center; align-items: center;
    padding: 0.85rem 1.4rem; border: 1px solid #16130f; font-size: 0.9rem; font-weight: 500;
    transition: background-color 0.3s, color 0.3s;
  }
  .d-editorial .ed-btn:hover { background: #16130f; color: #f2ede4; }
  .d-editorial .ed-btn-solid { background: #16130f; color: #f2ede4; }
  .d-editorial .ed-btn-solid:hover { background: #b8441f; border-color: #b8441f; }
  .d-editorial .ed-section-head {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    border-top: 2px solid #16130f; padding-top: 0.75rem; margin-bottom: 1.5rem;
    font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.16em;
  }
  .d-editorial .ed-frame { border: 1px solid rgba(22, 19, 15, 0.2); }
  .d-editorial .ed-photo { filter: grayscale(1) contrast(1.05); transition: filter 0.8s; }
  .d-editorial .ed-photo:hover { filter: none; }
  .d-editorial .ed-index { border-top: 1px solid rgba(22, 19, 15, 0.18); }
  .d-editorial .ed-index-row {
    display: flex; align-items: baseline; gap: 0.5rem; padding: 1.1rem 0;
    border-bottom: 1px solid rgba(22, 19, 15, 0.18);
  }
  .d-editorial .ed-preview {
    position: fixed; top: 0; left: 0; width: 340px; aspect-ratio: 16 / 10; object-fit: cover; object-position: top;
    pointer-events: none; z-index: 40; opacity: 0; transform: translate(-50%, -50%) scale(0.92);
    transition: opacity 0.25s, transform 0.35s var(--ease); box-shadow: 0 20px 40px rgba(0,0,0,.25);
  }
  .d-editorial .ed-preview.is-on { opacity: 1; }
  .d-editorial .ed-faq summary { list-style: none; }
  .d-editorial .ed-faq summary::-webkit-details-marker { display: none; }
  .d-editorial .ed-plus { transition: transform 0.35s var(--ease); }
  .d-editorial .ed-faq[open] .ed-plus { transform: rotate(45deg); }
  .d-editorial .ed-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.16em; color: #6d675d; }
  .d-editorial .ed-field {
    width: 100%; background: transparent; border: 0; border-bottom: 1px solid #16130f;
    padding: 0.7rem 0; font-size: 1.05rem; color: inherit; border-radius: 0;
  }
  .d-editorial .ed-field:focus { outline: none; border-bottom-color: #b8441f; }
  .d-editorial [data-status][data-state='ok'] { color: #2f6b3a; }
  .d-editorial [data-status][data-state='error'] { color: #b8441f; }
  @media (prefers-reduced-motion: reduce) {
    .d-editorial .ed-line > span { transform: none; animation: none; }
  }
</style>

<script>
  import { bindContactForms } from '../../scripts/contact-form';
  bindContactForms();

  // Floating preview that follows the cursor over the prototypes index
  const preview = document.getElementById('ed-preview') as HTMLImageElement | null;
  const fine = window.matchMedia('(hover: hover) and (min-width: 768px)').matches;
  if (preview && fine) {
    let x = 0, y = 0, cx = 0, cy = 0, raf = 0;
    const loop = () => {
      cx += (x - cx) * 0.15;
      cy += (y - cy) * 0.15;
      preview.style.transform = `translate(${cx + 30}px, ${cy - 110}px)`;
      raf = requestAnimationFrame(loop);
    };
    document.querySelectorAll<HTMLElement>('[data-preview]').forEach((row) => {
      row.addEventListener('mouseenter', (e) => {
        preview.src = row.dataset.preview ?? '';
        x = cx = e.clientX; y = cy = e.clientY;
        preview.classList.add('is-on');
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(loop);
      });
      row.addEventListener('mousemove', (e) => { x = e.clientX; y = e.clientY; });
      row.addEventListener('mouseleave', () => {
        preview.classList.remove('is-on');
        cancelAnimationFrame(raf);
      });
    });
  }
</script>
