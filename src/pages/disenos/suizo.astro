---
import Layout from '../../layouts/Layout.astro';
import DesignSwitcher from '../../components/DesignSwitcher.astro';
import ContactHidden from '../../components/ContactHidden.astro';
import { SITE_CONFIG } from '../../data/siteConfig';
import { FEATURED_PROJECTS, PROTOTYPES } from '../../data/projects';
import { HERO, SERVICES, STEPS, ABOUT, REASONS, FAQS, CONTACT_OPTIONS } from '../../data/content';

const rows = [
  ...FEATURED_PROJECTS.map((p) => ({ client: p.client, sector: p.sector, location: p.location, url: p.url, img: p.shotDesktop, status: 'Publicado' })),
  ...PROTOTYPES.map((p) => ({ client: p.client, sector: p.sector, location: p.location, url: p.url, img: p.shotDesktop, status: 'Prototipo' })),
];
const n = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout noindex bodyClass="d-swiss" fonts="family=Archivo:wght@400;500;600;700;800;900">
  <div class="sw-grid-bg" aria-hidden="true"><div class="sw-wrap sw-12 h-full">{Array.from({ length: 12 }).map(() => <span></span>)}</div></div>

  <header class="sw-wrap sw-12 pt-5 pb-4 text-[13px] relative z-10">
    <a href="/disenos/suizo/" class="col-span-6 md:col-span-3 font-bold">Hernán Solis</a>
    <p class="hidden md:block md:col-span-3">Desarrollo web<br />a medida</p>
    <p class="hidden md:block md:col-span-3">Tortuguitas, Bs. As.<br />34°28′S 58°45′O</p>
    <nav class="col-span-6 md:col-span-3 text-right flex flex-col items-end" aria-label="Principal">
      <a href="#trabajos" class="sw-link">Trabajos</a>
      <a href="#contacto" class="sw-link">Contacto</a>
    </nav>
  </header>

  <main class="relative z-10">
    <!-- Hero -->
    <section class="sw-wrap pt-16 md:pt-28 pb-20 md:pb-32">
      <div class="sw-12 items-end">
        <h1 class="col-span-12 lg:col-span-11 sw-display">
          <span class="sw-reveal" style="--d:.05s">Páginas web</span>
          <span class="sw-reveal" style="--d:.15s">a medida para</span>
          <span class="sw-reveal" style="--d:.25s">negocios de</span>
          <span class="sw-reveal" style="--d:.35s">Zona Norte<span class="sw-red">.</span></span>
        </h1>
      </div>
      <div class="sw-12 mt-12 md:mt-16">
        <div class="col-span-12 md:col-span-3 mb-6 md:mb-0">
          <span class="sw-square" aria-hidden="true"></span>
        </div>
        <p class="col-span-12 md:col-span-6 text-lg md:text-2xl leading-snug font-medium fade-in" style="--d:.6s">{HERO.lead}</p>
        <div class="col-span-12 md:col-span-3 mt-8 md:mt-0 flex md:justify-end items-start gap-3 fade-in" style="--d:.7s">
          <a href="#contacto" class="sw-btn">Presupuesto →</a>
        </div>
      </div>
    </section>

    <!-- 01 Work index -->
    <section id="trabajos" class="sw-wrap py-16 md:py-24 border-t-2 border-black">
      <div class="sw-12 mb-10">
        <p class="col-span-2 md:col-span-3 sw-secnum">01</p>
        <h2 class="col-span-10 md:col-span-9 sw-h2">Trabajos</h2>
      </div>
      <div class="sw-12">
        <div class="hidden lg:block lg:col-span-5">
          <div class="sticky top-8">
            <div class="aspect-[16/10] bg-neutral-100 overflow-hidden border border-black">
              <img id="sw-preview" src={rows[0].img} alt="" class="w-full h-full object-cover object-top transition-opacity duration-300" />
            </div>
            <p id="sw-caption" class="mt-3 text-sm">{rows[0].client} — {rows[0].status}</p>
          </div>
        </div>
        <div class="col-span-12 lg:col-span-7">
          <div class="sw-row sw-row-head text-xs uppercase tracking-wider">
            <span>Nº</span><span>Cliente</span><span class="hidden sm:block">Rubro</span><span class="text-right">Estado</span>
          </div>
          <ol data-reveal>
            {rows.map((r, i) => (
              <li>
                <a href={r.url} target="_blank" rel="noopener noreferrer" class="sw-row sw-row-link" data-img={r.img} data-caption={`${r.client} — ${r.status}`}>
                  <span class="tabular-nums">{n(i)}</span>
                  <span class="font-bold">{r.client}<span class="block sm:hidden font-normal text-sm opacity-70">{r.sector}</span></span>
                  <span class="hidden sm:block">{r.sector}<span class="block text-sm opacity-60">{r.location}</span></span>
                  <span class="text-right text-sm"><span class:list={['sw-status', r.status === 'Prototipo' && 'sw-status-proto']}>{r.status}</span></span>
                </a>
                <img src={r.img} alt={`${r.client}`} loading="lazy" class="lg:hidden w-full aspect-[16/9] object-cover object-top border border-black mb-6" />
              </li>
            ))}
          </ol>
          <p class="mt-6 text-sm max-w-md">Los prototipos son propuestas funcionando para negocios de la zona, todavía sin su dominio propio.</p>
        </div>
      </div>
    </section>

    <!-- 02 Services -->
    <section class="sw-wrap py-16 md:py-24 border-t-2 border-black">
      <div class="sw-12 mb-10">
        <p class="col-span-2 md:col-span-3 sw-secnum">02</p>
        <h2 class="col-span-10 md:col-span-9 sw-h2">Servicios</h2>
      </div>
      <div class="sw-12 gap-y-12">
        <div class="hidden md:block md:col-span-3"></div>
        {SERVICES.map((s, i) => (
          <article class="col-span-12 md:col-span-3" data-reveal style={`--d:${i * 0.08}s`}>
            <p class="sw-red text-5xl font-black leading-none">{i + 1}</p>
            <h3 class="text-2xl font-bold mt-4 leading-tight">{s.title}</h3>
            <p class="mt-3 leading-relaxed">{s.desc}</p>
            <ul class="mt-4 text-sm border-t border-black">
              {s.items.map((it) => <li class="py-2 border-b border-black">{it}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <!-- 03 Process -->
    <section class="sw-wrap py-16 md:py-24 border-t-2 border-black">
      <div class="sw-12 mb-10">
        <p class="col-span-2 md:col-span-3 sw-secnum">03</p>
        <h2 class="col-span-10 md:col-span-9 sw-h2">Proceso</h2>
      </div>
      <ol class="sw-12 gap-y-10" data-reveal>
        {STEPS.map((s, i) => (
          <li class="col-span-12 sm:col-span-6 md:col-span-3">
            <div class="sw-bar"><span style={`--d:${i * 0.15}s`}></span></div>
            <p class="text-sm mt-4 tabular-nums">{n(i)}</p>
            <h3 class="text-xl font-bold mt-1">{s.title}</h3>
            <p class="mt-2 leading-relaxed">{s.desc}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 04 About -->
    <section class="sw-wrap py-16 md:py-24 border-t-2 border-black">
      <div class="sw-12 mb-10">
        <p class="col-span-2 md:col-span-3 sw-secnum">04</p>
        <h2 class="col-span-10 md:col-span-9 sw-h2">Sobre mí</h2>
      </div>
      <div class="sw-12 gap-y-10">
        <div class="col-span-12 md:col-span-3" data-reveal>
          <img src={ABOUT.photo} alt="Hernán Solis" loading="lazy" class="w-full aspect-[3/4] object-cover grayscale contrast-125" />
        </div>
        <div class="col-span-12 md:col-span-6" data-reveal style="--d:.08s">
          <p class="text-2xl md:text-4xl font-bold leading-tight">{ABOUT.title}.</p>
          {ABOUT.paragraphs.map((t) => <p class="mt-5 text-lg leading-relaxed">{t}</p>)}
        </div>
        <ul class="col-span-12 md:col-span-3 border-t border-black" data-reveal style="--d:.16s">
          {REASONS.map((r) => (
            <li class="py-4 border-b border-black">
              <h3 class="font-bold">{r.title}</h3>
              <p class="text-sm mt-1">{r.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 05 FAQ -->
    <section class="sw-wrap py-16 md:py-24 border-t-2 border-black">
      <div class="sw-12 mb-10">
        <p class="col-span-2 md:col-span-3 sw-secnum">05</p>
        <h2 class="col-span-10 md:col-span-9 sw-h2">Preguntas</h2>
      </div>
      <div class="sw-12">
        <div class="hidden md:block md:col-span-3"></div>
        <dl class="col-span-12 md:col-span-9 grid md:grid-cols-2 gap-x-10 gap-y-10">
          {FAQS.map((f, i) => (
            <div data-reveal style={`--d:${(i % 2) * 0.08}s`}>
              <dt class="font-bold text-lg leading-snug border-t-2 border-black pt-3">{f.q}</dt>
              <dd class="mt-3 leading-relaxed">{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 06 Contact -->
    <section id="contacto" class="sw-contact">
      <div class="sw-wrap py-16 md:py-24">
        <div class="sw-12 mb-10">
          <p class="col-span-2 md:col-span-3 sw-secnum !text-white">06</p>
          <h2 class="col-span-10 md:col-span-9 sw-display !text-white">Hablemos.</h2>
        </div>
        <div class="sw-12 gap-y-10">
          <div class="col-span-12 md:col-span-3 md:col-start-4">
            <p class="text-lg leading-snug">Escribime con tu idea, aunque sea un borrador.</p>
            <a href={`mailto:${SITE_CONFIG.email}`} class="block mt-4 font-bold underline underline-offset-4 break-all">{SITE_CONFIG.email}</a>
          </div>
          <form data-contact-form action={SITE_CONFIG.contactFormEndpoint} method="POST" class="col-span-12 md:col-span-6 grid gap-6">
            <ContactHidden />
            <div class="grid sm:grid-cols-2 gap-6">
              <label><span class="sw-label">Nombre</span><input name="name" required autocomplete="name" class="sw-input" /></label>
              <label><span class="sw-label">Email</span><input name="email" type="email" required autocomplete="email" class="sw-input" /></label>
            </div>
            <label><span class="sw-label">Qué necesitás</span>
              <select name="tipo" class="sw-input">{CONTACT_OPTIONS.map((o) => <option class="text-black">{o}</option>)}</select>
            </label>
            <label><span class="sw-label">Mensaje</span><textarea name="message" rows="3" required class="sw-input resize-none"></textarea></label>
            <div class="flex flex-wrap items-center gap-5">
              <button type="submit" class="sw-btn sw-btn-white"><span data-submit-label>Enviar →</span></button>
              <p data-status role="status" aria-live="polite" class="text-sm font-bold"></p>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="sw-wrap sw-12 py-6 pb-24 text-[13px] relative z-10">
    <p class="col-span-12 md:col-span-6">© {new Date().getFullYear()} Hernán Solis</p>
    <p class="col-span-12 md:col-span-6 md:text-right flex md:justify-end gap-5 mt-2 md:mt-0">
      <a href={SITE_CONFIG.linkedin} target="_blank" rel="noopener noreferrer" class="sw-link">LinkedIn</a>
      <a href={SITE_CONFIG.github} target="_blank" rel="noopener noreferrer" class="sw-link">GitHub</a>
    </p>
  </footer>

  <DesignSwitcher current="suizo" />
</Layout>

<style is:global>
  body.d-swiss { background: #fff; color: #000; font-family: 'Archivo', 'Helvetica Neue', Arial, sans-serif; }
  html:has(body.d-swiss) { background: #fff; color-scheme: light; }
  body.d-swiss ::selection { background: #e30613; color: #fff; }
  .d-swiss h1, .d-swiss h2, .d-swiss h3 { font-family: 'Archivo', 'Helvetica Neue', Arial, sans-serif; }
  .d-swiss .sw-wrap { max-width: 90rem; margin-inline: auto; padding-inline: 1rem; }
  @media (min-width: 768px) { .d-swiss .sw-wrap { padding-inline: 2rem; } }
  .d-swiss .sw-12 { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1rem; }
  @media (min-width: 768px) { .d-swiss .sw-12 { column-gap: 1.5rem; } }
  .d-swiss .sw-grid-bg { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
  .d-swiss .sw-grid-bg span { background: rgba(227, 6, 19, 0.045); }
  @media (max-width: 767px) { .d-swiss .sw-grid-bg { display: none; } }
  .d-swiss .sw-red { color: #e30613; }
  .d-swiss .sw-display { font-size: clamp(3rem, 11vw, 11rem); line-height: 0.88; font-weight: 800; letter-spacing: -0.055em; }
  .d-swiss .sw-reveal { display: block; clip-path: inset(0 0 100% 0); transform: translateY(30%); animation: swIn 1s var(--ease) forwards; animation-delay: var(--d, 0s); }
  @keyframes swIn { to { clip-path: inset(0 0 -10% 0); transform: none; } }
  .d-swiss .sw-square { display: block; width: 72px; height: 72px; background: #e30613; transform: scale(0); transform-origin: bottom left; animation: swSq .8s var(--ease) .5s forwards; }
  @keyframes swSq { to { transform: scale(1); } }
  .d-swiss .sw-secnum { font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 800; color: #e30613; line-height: 1; }
  .d-swiss .sw-h2 { font-size: clamp(2rem, 5vw, 4.5rem); font-weight: 800; letter-spacing: -0.04em; line-height: 0.95; }
  .d-swiss .sw-link { background: linear-gradient(#000, #000) 0 100% / 0 2px no-repeat; transition: background-size .3s; }
  .d-swiss .sw-link:hover { background-size: 100% 2px; }
  .d-swiss .sw-btn { display: inline-block; background: #000; color: #fff; padding: 1rem 1.5rem; font-weight: 700; transition: background-color .2s; }
  .d-swiss .sw-btn:hover { background: #e30613; }
  .d-swiss .sw-btn-white { background: #fff; color: #000; }
  .d-swiss .sw-btn-white:hover { background: #000; color: #fff; }
  .d-swiss .sw-row { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1rem; padding: 1rem 0.5rem; border-bottom: 1px solid #000; align-items: baseline; }
  @media (min-width: 640px) { .d-swiss .sw-row { grid-template-columns: 2.5rem 1.2fr 1.4fr auto; } }
  .d-swiss .sw-row-head { border-bottom: 2px solid #000; padding-block: 0.5rem; }
  .d-swiss .sw-row-link { font-size: 1.05rem; transition: background-color .15s, color .15s; }
  .d-swiss .sw-row-link:hover { background: #000; color: #fff; }
  .d-swiss .sw-row-link:hover .sw-status { border-color: #fff; }
  .d-swiss .sw-status { display: inline-block; border: 1px solid #000; padding: 2px 8px; font-size: 12px; }
  .d-swiss .sw-status-proto { background: #e30613; color: #fff; border-color: #e30613; }
  .d-swiss .sw-bar { height: 6px; background: #eee; }
  .d-swiss .sw-bar span { display: block; height: 100%; background: #000; transform: scaleX(0); transform-origin: left; transition: transform 1.2s var(--ease); transition-delay: var(--d, 0s); }
  .d-swiss .is-visible .sw-bar span { transform: scaleX(1); }
  .d-swiss .sw-contact { background: #e30613; color: #fff; position: relative; z-index: 10; }
  .d-swiss .sw-label { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
  .d-swiss .sw-input { width: 100%; background: transparent; border: 0; border-bottom: 2px solid #fff; padding: .6rem 0; color: #fff; font: inherit; font-size: 1.1rem; border-radius: 0; }
  .d-swiss .sw-input:focus { outline: none; border-bottom-color: #000; }
  .d-swiss [data-status][data-state='error'] { color: #000; }
  @media (prefers-reduced-motion: reduce) { .d-swiss .sw-reveal, .d-swiss .sw-square { animation: none; clip-path: none; transform: none; } }
</style>

<script>
  import { bindContactForms } from '../../scripts/contact-form';
  bindContactForms('Recibido. Te respondo a la brevedad.');

  const preview = document.getElementById('sw-preview') as HTMLImageElement | null;
  const caption = document.getElementById('sw-caption');
  document.querySelectorAll<HTMLElement>('.sw-row-link').forEach((row) => {
    row.addEventListener('mouseenter', () => {
      if (!preview || preview.src.endsWith(row.dataset.img ?? '')) return;
      preview.style.opacity = '0';
      setTimeout(() => {
        preview.src = row.dataset.img ?? '';
        preview.style.opacity = '1';
      }, 150);
      if (caption) caption.textContent = row.dataset.caption ?? '';
    });
  });
</script>
